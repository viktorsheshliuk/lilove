<?php
class ControllerExtensionModuleTdsearchcategory extends Controller {
    private $error = array();

    public function install() {

        $config = array(
            'module_tdsearchcategory_status' => 1,
            'module_tdsearchcategory_ajax_enabled' => 1,
            'module_tdsearchcategory_cat_dropdwon' => 1,
            'module_tdsearchcategory_product_img' => 1,
            'module_tdsearchcategory_product_price' => 1,
        );
        $this->load->model('setting/setting');
        $this->model_setting_setting->editSetting('module_tdsearchcategory', $config);

    }

    public function index() {
        $this->load->language('extension/module/tdsearchcategory');

        $this->document->setTitle($this->language->get('page_title'));

        $this->load->model('setting/setting');
        $this->load->model('tool/image');

        if (($this->request->server['REQUEST_METHOD'] == 'POST') && $this->validate()) {
            $post_data = $this->request->post;

            $this->model_setting_setting->editSetting('module_tdsearchcategory', $post_data);

            $this->session->data['success'] = $this->language->get('text_success');

            /* Custom Code for Save & Stay */
            if (isset($this->request->post['saveandstay'])) {
                $get = explode("/", $this->request->get['route']);
                $folder = $get[0];
                $file = $get[1];

                if ($file == 'user_permission') {
                    $table = 'user_group';
                } else {
                    $table = $file;
                }

                $this->load->model('tdmodules/product');
                $last_id = $this->model_tdmodules_product->getLastInsertID($table);

                $editroute = $folder.'/'.$file.'/tdsearchcategory';

                if (!isset($url)) {
                    $url = "";
                }

                if ((isset($this->request->get[$table.'_id']) || $last_id)) {
                    $url .= '&'.$table.'_id='.(isset($this->request->get[$table.'_id']) ? $this->request->get[$table.'_id'] : $last_id);
                }

                if ($this->request->post['saveandstay']) {
                    $this->response->redirect($this->url->link($editroute, 'user_token='.$this->session->data['user_token'].$url, 'SSL'));
                }
            }
            /* Custom Code for Save & Stay */

            $this->response->redirect($this->url->link('marketplace/extension', 'user_token=' . $this->session->data['user_token'] . '&type=module', true));
        }

        if (isset($this->error['warning'])) {
            $data['error_warning'] = $this->error['warning'];
        } else {
            $data['error_warning'] = '';
        }

        $data['breadcrumbs'] = array();

        $data['breadcrumbs'][] = array(
            'text' => $this->language->get('text_home'),
            'href' => $this->url->link('common/dashboard', 'user_token=' . $this->session->data['user_token'], true)
        );

        $data['breadcrumbs'][] = array(
            'text' => $this->language->get('text_extension'),
            'href' => $this->url->link('marketplace/extension', 'user_token=' . $this->session->data['user_token'] . '&type=module', true)
        );

        $data['breadcrumbs'][] = array(
            'text' => $this->language->get('heading_title'),
            'href' => $this->url->link('extension/module/tdsearchcategory', 'user_token=' . $this->session->data['user_token'], true)
        );

        $data['action'] = $this->url->link('extension/module/tdsearchcategory', 'user_token=' . $this->session->data['user_token'], true);

        $data['cancel'] = $this->url->link('marketplace/extension', 'user_token=' . $this->session->data['user_token'] . '&type=module', true);

        if (isset($this->request->post['module_tdsearchcategory_status'])) {
            $data['module_tdsearchcategory_status'] = $this->request->post['module_tdsearchcategory_status'];
        } else {
            $data['module_tdsearchcategory_status'] = $this->config->get('module_tdsearchcategory_status');
        }

        if (isset($this->request->post['module_tdsearchcategory_ajax_enabled'])) {
            $data['module_tdsearchcategory_ajax_enabled'] = $this->request->post['module_tdsearchcategory_ajax_enabled'];
        } else {
            $data['module_tdsearchcategory_ajax_enabled'] = $this->config->get('module_tdsearchcategory_ajax_enabled');
        }

        if (isset($this->request->post['module_tdsearchcategory_cat_dropdwon'])) {
            $data['module_tdsearchcategory_cat_dropdwon'] = $this->request->post['module_tdsearchcategory_cat_dropdwon'];
        } else {
            $data['module_tdsearchcategory_cat_dropdwon'] = $this->config->get('module_tdsearchcategory_cat_dropdwon');
        }

        if (isset($this->request->post['module_tdsearchcategory_product_img'])) {
            $data['module_tdsearchcategory_product_img'] = $this->request->post['module_tdsearchcategory_product_img'];
        } else {
            $data['module_tdsearchcategory_product_img'] = $this->config->get('module_tdsearchcategory_product_img');
        }

        if (isset($this->request->post['module_tdsearchcategory_product_price'])) {
            $data['module_tdsearchcategory_product_price'] = $this->request->post['module_tdsearchcategory_product_price'];
        } else {
            $data['module_tdsearchcategory_product_price'] = $this->config->get('module_tdsearchcategory_product_price');
        }

        $this->document->addStyle('view/stylesheet/admin-styles.css');

        $data['header'] = $this->load->controller('common/header');
        $data['column_left'] = $this->load->controller('common/column_left');
        $data['footer'] = $this->load->controller('common/footer');

        $this->response->setOutput($this->load->view('extension/module/tdsearchcategory', $data));
    }

    protected function validate() {
        if (!$this->user->hasPermission('modify', 'extension/module/tdsearchcategory')) {
            $this->error['warning'] = $this->language->get('error_permission');
        }

        return !$this->error;
    }
}