				'disapprove'         => $this->url->link('extension/module/tdblog/disapprove_comment', 'user_token=' . $this->session->data['user_token'] . '&tdblog_id=' . $this->request->get['tdblog_id'] . '&tdblog_comment_id=' . $result['tdblog_comment_id'] . $url, true),
				'view'               => $this->url->link('extension/module/tdblog/view_comment', 'user_token=' . $this->session->data['user_token'] . '&tdblog_id=' . $this->request->get['tdblog_id'] . '&tdblog_comment_id=' . $result['tdblog_comment_id'] . $url, true)
			);
