{{ header }}{{ column_left }}
<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <div class="pull-right">
                <button type="submit" form="form-tdsearchcategory" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
                <button onclick="$('#content form #saveandstay').attr('value', '1'); $('#' + $('#content form').attr('id')).submit();" data-toggle="tooltip" title="{{ button_savestay }}" class="btn btn-warning"><i class="fa fa-save"></i></button>
                <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
            <h1>{{ heading_title }}</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %}
                <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>
   <div class="container-fluid">
        {% if error_warning %}
        <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
        {% endif %}
        <div class="panel panel-default custom-panel">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
            </div>
            <div class="panel-body">
                <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-tdsearchcategory" class="form-horizontal">
                    <div class="form-group">
                        <label class="control-label" for="input-status">{{ entry_status }}</label>
                        <div class="control-group">
                           <div class="switch-field">
                              <input type="radio" name="module_tdsearchcategory_status" id="status_on" value="1" {% if module_tdsearchcategory_status == 1 %} checked="checked" {% endif %}/>
                              <label for="status_on">{{ text_enabled }}</label>
                              <input type="radio" name="module_tdsearchcategory_status" id="status_off" value="0" {% if module_tdsearchcategory_status == 0 %} checked="checked" {% endif %}/>
                              <label for="status_off">{{ text_disabled }}</label>
                          </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label" for="input-ajax-enabled">{{ entry_ajax_enabled }}</label>
                        <div class="control-group">
                            <div class="switch-field">
                              <input type="radio" name="module_tdsearchcategory_ajax_enabled" id="tdsearchcategory_ajax_on" class="form-control" value="1" {% if module_tdsearchcategory_ajax_enabled == 1 %} checked="checked" {% endif %}/>
                              <label for="tdsearchcategory_ajax_on">{{ text_enabled }}</label>
                              <input type="radio" name="module_tdsearchcategory_ajax_enabled" id="tdsearchcategory_ajax_off" class="form-control" value="0" {% if module_tdsearchcategory_ajax_enabled == 0 %} checked="checked" {% endif %}/>
                              <label for="tdsearchcategory_ajax_off">{{ text_disabled }}</label>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label" for="input-cat_dropdwon">{{ entry_cat_dropdwon }}</label>
                        <div class="control-group">
                            <div class="switch-field">
                              <input type="radio" name="module_tdsearchcategory_cat_dropdwon" id="tdsearchcategory_cat_dropdwon_on" class="form-control" value="1" {% if module_tdsearchcategory_cat_dropdwon == 1 %} checked="checked" {% endif %}/>
                              <label for="tdsearchcategory_cat_dropdwon_on">{{ text_enabled }}</label>
                              <input type="radio" name="module_tdsearchcategory_cat_dropdwon" id="tdsearchcategory_cat_dropdwon_off" class="form-control" value="0" {% if module_tdsearchcategory_cat_dropdwon == 0 %} checked="checked" {% endif %}/>
                              <label for="tdsearchcategory_cat_dropdwon_off">{{ text_disabled }}</label>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label" for="input-pimage">{{ entry_product_image }}</label>
                        <div class="control-group">
                            <div class="switch-field">
                              <input type="radio" name="module_tdsearchcategory_product_img" id="product_img_on" class="form-control" value="1" {% if module_tdsearchcategory_product_img == 1 %} checked="checked" {% endif %}/>
                              <label for="product_img_on">{{ text_enabled }}</label>
                              <input type="radio" name="module_tdsearchcategory_product_img" id="product_img_off" class="form-control" value="0" {% if module_tdsearchcategory_product_img == 0 %} checked="checked" {% endif %}/>
                              <label for="product_img_off">{{ text_disabled }}</label>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label" for="input-price">{{ entry_product_price }}</label>
                        <div class="control-group">
                            <div class="switch-field">
                              <input type="radio" name="module_tdsearchcategory_product_price" id="product_price_on" class="form-control" value="1" {% if module_tdsearchcategory_product_price == 1 %} checked="checked" {% endif %}/>
                              <label for="product_price_on">{{ text_enabled }}</label>
                              <input type="radio" name="module_tdsearchcategory_product_price" id="product_price_off" class="form-control" value="0" {% if module_tdsearchcategory_product_price == 0 %} checked="checked" {% endif %}/>
                              <label for="product_price_off">{{ text_disabled }}</label>
                            </div>
                        </div>
                    </div>
                    <input type="hidden" name="saveandstay" id="saveandstay" value="0">
                </form>
            </div>
        </div>
    </div>
</div>
{{ footer }}
