{{ header }}{{ column_left }}
<div id="content">
   <div class="page-header">
     <div class="container-fluid">
        <div class="pull-right buttons">
           <button type="button" onclick="applyButton()" data-toggle="tooltip" title="{{ text_save_and_stay }}" class="btn btn-success">
           <i class="fa fa-check fa-fw s-icon"></i>
           <i class="fa fa-spinner fa-pulse fa-fw l-icon"></i>
           </button>
           <button type="submit" form="form-module" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
           <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
        </div>
        <h1>{{ heading_title }}</h1>
        <ul class="breadcrumb">
           {% for breadcrumb in breadcrumbs %}
           <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
           {% endfor %}
        </ul>
     </div>
  </div>
   <div class="container-fluid">
      {% if error_warning %}
      <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
         <button type="button" class="close" data-dismiss="alert">&times;</button>
      </div>
      {% endif %}
      <div class="panel panel-default">
         <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
         </div>
         <div class="panel-body">
            <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-module" class="form-horizontal">
               <div class="form-group">
                  <label class="col-sm-3 control-label">{{ entry_status }}</label>
                  <div class="col-sm-9">
                     <div class="btn-group" data-toggle="buttons">
                        <label class="btn btn-default {% if not status %} active {% endif %}">
                        <input type="radio" name="status" value="0" {% if not status %} checked {% endif %}>
                        <span class="on-off">{{ text_disabled }}</span>
                        </label>
                        <label class="btn btn-default {% if status %} active {% endif %}">
                        <input type="radio" name="status" value="1" {% if status %} checked {% endif %}>
                        <span class="on-off">{{ text_enabled }}</span>
                        </label>
                     </div>
                  </div>
               </div>
               <hr>
               <div class="form-group">
                  <label class="col-sm-3 control-label">{{ entry_retina_status }}</label>
                  <div class="col-sm-9">
                     <div class="btn-group" data-toggle="buttons">
                        <label class="btn btn-default {% if not retina_status %} active {% endif %}">
                        <input type="radio" name="retina_status" value="0" {% if not retina_status %} checked {% endif %}>
                        <span class="on-off">{{ text_disabled }}</span>
                        </label>
                        <label class="btn btn-default {% if retina_status %} active {% endif %}">
                        <input type="radio" name="retina_status" value="1" {% if retina_status %} checked {% endif %}>
                        <span class="on-off">{{ text_enabled }}</span>
                        </label>
                     </div>
                  </div>
               </div>
               <hr>
               <div class="form-group {% if error_name %} has-error {% endif %}">
                  <label class="col-sm-3 control-label" for="input-item_width">{{ entry_item_width }}</label>
                  <div class="col-sm-9">
                     <input type="text" name="item_width" value="{{ item_width }}" placeholder="{{ entry_item_width }}" id="input-item_width" class="form-control" />
                     {% if error_item_width %}
                     <div class="text-danger">{{ error_item_width }}</div>
                     {% endif %}
                  </div>
               </div>
               <hr>
               <div class="form-group {% if error_name %} has-error {% endif %}">
                  <label class="col-sm-3 control-label" for="input-item_gap">{{ entry_item_gap }}</label>
                  <div class="col-sm-9">
                     <input type="text" name="item_gap" value="{{ item_gap }}" placeholder="{{ entry_item_gap }}" id="input-item_gap" class="form-control" />
                     {% if error_item_gap %}
                     <div class="text-danger">{{ error_item_gap }}</div>
                     {% endif %}
                  </div>
               </div>
               <hr>
               <div class="form-group {% if error_name %} has-error {% endif %}">
                  <label class="col-sm-3 control-label" for="input-name">{{ entry_name }}<span data-toggle="tooltip" title="{{ help_name_module }}"></span></label>
                  <div class="col-sm-9">
                     <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control" />
                     {% if error_name %}
                     <div class="text-danger">{{ error_name }}</div>
                     {% endif %}
                  </div>
               </div>
               <hr>
               <div class="form-group">
                  <label class="col-sm-3 control-label">{{ entry_title }}<span data-toggle="tooltip" title="{{ help_title_module }}"></span></label>
                  <div class="col-sm-9">
                     {% for lang in langs %}
                     <div class="input-group">
                        <span class="input-group-addon">
                        <img src="language/{{ lang.code }}/{{ lang.code }}.png" title="{{ lang.name }}" />
                        </span>
                        <input name="title[{{ lang.language_id }}]" value="{{ title[lang.language_id] }}" class="form-control" />
                     </div>
                     {% endfor %}
                  </div>
               </div>
               <hr>
               <div class="form-group">
                  <label class="col-sm-3 control-label" for="input-category"><span data-toggle="tooltip" title="{{ help_category }}">{{ entry_category }}</span></label>
                  <div class="col-sm-9">
                     <input type="text" name="category" value="" placeholder="{{ entry_category_name }}" id="input-category" class="form-control" />
                     <div id="category" class="well well-sm" style="height: 200px; overflow: auto;">
                        {% for category in categories %}
                        <div id="category{{ category.category_id }}"><i class="fa fa-minus-circle red"></i> {{ category.name }}
                           <input type="hidden" name="category[]" value="{{ category.category_id }}" />
                        </div>
                        {% endfor %}
                     </div>
                  </div>
               </div>
               <hr>
               <div class="form-group">
                  <label class="col-sm-3 control-label" for="input-limit"><span data-toggle="tooltip" title="{{ help_limit }}">{{ entry_limit }}</span></label>
                  <div class="col-sm-9">
                     <input type="text" name="limit" value="{{ limit }}" placeholder="{{ entry_limit }}" id="input-limit" class="form-control" />
                  </div>
               </div>
               <hr>
               <div class="form-group {% if error_width %} has-error {% endif %}">
                  <label class="col-sm-3 control-label" for="input-width">{{ entry_width }}</label>
                  <div class="col-sm-9">
                     <input type="text" name="width" value="{{ width }}" placeholder="{{ entry_width }}" id="input-width" class="form-control" />
                     {% if error_width %}
                     <div class="text-danger">{{ error_width }}</div>
                     {% endif %}
                  </div>
               </div>
               <hr>
               <div class="form-group {% if error_height %} has-error {% endif %}">
                  <label class="col-sm-3 control-label" for="input-height">{{ entry_height }}</label>
                  <div class="col-sm-9">
                     <input type="text" name="height" value="{{ height }}" placeholder="{{ entry_height }}" id="input-height" class="form-control" />
                     {% if error_height %}
                     <div class="text-danger">{{ error_height }}</div>
                     {% endif %}
                  </div>
               </div>
               <hr>
               <div class="form-group">
                  <label class="col-sm-3 control-label">{{text_xs}}</label>
                  <div class="col-sm-9">
                     <div class="btn-group" data-toggle="buttons">
                        <label class="btn btn-default {% if not xs_status %} active {% endif %}">
                        <input type="radio" name="xs_status" value="0" {% if not xs_status %} checked {% endif %}>
                        <span class="on-off">{{ text_disabled }}</span>
                        </label>
                        <label class="btn btn-default {% if xs_status %} active {% endif %}">
                        <input type="radio" name="xs_status" value="1" {% if xs_status %} checked {% endif %}>
                        <span class="on-off">{{ text_enabled }}</span>
                        </label>
                     </div>
                  </div>
               </div>
               <hr>
               <div class="form-group">
                  <label class="col-sm-3 control-label">{{text_sm}}</label>
                  <div class="col-sm-9">
                     <div class="btn-group" data-toggle="buttons">
                        <label class="btn btn-default {% if not sm_status %} active {% endif %}">
                        <input type="radio" name="sm_status" value="0" {% if not sm_status %} checked {% endif %}>
                        <span class="on-off">{{ text_disabled }}</span>
                        </label>
                        <label class="btn btn-default {% if sm_status %} active {% endif %}">
                        <input type="radio" name="sm_status" value="1" {% if sm_status %} checked {% endif %}>
                        <span class="on-off">{{ text_enabled }}</span>
                        </label>
                     </div>
                  </div>
               </div>
               <hr>
               <div class="form-group">
                  <label class="col-sm-3 control-label">{{text_md}}</label>
                  <div class="col-sm-9">
                     <div class="btn-group" data-toggle="buttons">
                        <label class="btn btn-default {% if not md_status %} active {% endif %}">
                        <input type="radio" name="md_status" value="0" {% if not md_status %} checked {% endif %}>
                        <span class="on-off">{{ text_disabled }}</span>
                        </label>
                        <label class="btn btn-default {% if md_status %} active {% endif %}">
                        <input type="radio" name="md_status" value="1" {% if md_status %} checked {% endif %}>
                        <span class="on-off">{{ text_enabled }}</span>
                        </label>
                     </div>
                  </div>
               </div>
               <hr>
               <div class="form-group">
                  <label class="col-sm-3 control-label">{{text_lg}}</label>
                  <div class="col-sm-9">
                     <div class="btn-group" data-toggle="buttons">
                        <label class="btn btn-default {% if not lg_status %} active {% endif %}">
                        <input type="radio" name="lg_status" value="0" {% if not lg_status %} checked {% endif %}>
                        <span class="on-off">{{ text_disabled }}</span>
                        </label>
                        <label class="btn btn-default {% if lg_status %} active {% endif %}">
                        <input type="radio" name="lg_status" value="1" {% if lg_status %} checked {% endif %}>
                        <span class="on-off">{{ text_enabled }}</span>
                        </label>
                     </div>
                  </div>
               </div>
               <hr>
               <div class="form-group">
                  <label class="col-sm-3 control-label">{{text_xl}}</label>
                  <div class="col-sm-9">
                     <div class="btn-group" data-toggle="buttons">
                        <label class="btn btn-default {% if not xl_status %} active {% endif %}">
                        <input type="radio" name="xl_status" value="0" {% if not xl_status %} checked {% endif %}>
                        <span class="on-off">{{ text_disabled }}</span>
                        </label>
                        <label class="btn btn-default {% if xl_status %} active {% endif %}">
                        <input type="radio" name="xl_status" value="1" {% if xl_status %} checked {% endif %}>
                        <span class="on-off">{{ text_enabled }}</span>
                        </label>
                     </div>
                  </div>
               </div>
            </form>
         </div>
      </div>
   </div>
</div>
<script type="text/javascript">
   function applyButton(){
    $(".alert").remove();
    $.ajax({
      type: "post",
      url: $("#form-module").attr('action'),
      data: $("#form-module").serialize(),
      dataType: 'html',
      beforeSend: function() {
        $('.panel.panel-default').before('<div class="overlay"></div>')
        $('body').addClass('wait_for_ajax');
        $('.buttons .btn').addClass('disabled');
      },
      success: function(html) {
        $('.overlay').remove();
        var $href = $(html).find(".well [selected=\"selected\"]").val();
        if ($href) {
          $.ajax({
            type: "post",
            url: $href,
            data: '',
            dataType: 'html',
            success: function(html) {
              var $success = $(html).find('.alert-success, .alert-danger');
              if ($success.length > 0) {
                $('.panel-default').before($success);
                $('body').removeClass('wait_for_ajax');
                $('.buttons .btn').removeClass('disabled');
              }

            }
          });
        } else {
          var $success = $(html).find('.alert-success, .alert-danger'),
              $content = $(html).find('.panel-default').html();
   
          if ($success.length > 0) {
            $('.panel-default').before($success);
          } else {
            $('.panel-default').html($content);
          }
          $('body').removeClass('wait_for_ajax');
          $('.buttons .btn').removeClass('disabled');
        }
      }
    });
   }
</script>
<script>
   // Remove category from list
   $('input[name=\'category\']').autocomplete({
     'source': function(request, response) {
       $.ajax({
         url: 'index.php?route=catalog/category/autocomplete&user_token={{ user_token }}&filter_name=' +  encodeURIComponent(request),
         dataType: 'json',
         success: function(json) {
           response($.map(json, function(result) {
             return {
               label: result['name'],
               value: result['category_id']
             }
           }));
         }
       });
     },
     'select': function(result) {
       $('input[name=\'category\']').val('');
   
       $('#category' + result['value']).remove();
   
       $('#category').append('<div id="category' + result['value'] + '"><i class="fa fa-minus-circle red"></i> ' + result['label'] + '<input type="hidden" name="category[]" value="' + result['value'] + '" /></div>');
     }
   });
   
   $('#category').delegate('.fa-minus-circle', 'click', function() {
     $(this).parent().remove();
   });
</script>
<style>
  .item-row > div {margin: 10px;}
  #infoblocks .head, #infoblocks .item-row {display: flex;align-items: center;justify-content: space-around;text-align: center}
  #infoblocks .head >div, #infoblocks .item-row>div {flex: 1;}
  .head div {display:block;width:100%;background: #ddd;padding: .5rem; text-align: center;}
  .container-fluid {position: relative;}
  .overlay {position: absolute;background: #4cb64c54;width: 100%;height: 100%;left: 0;top: 0;right: 0;bottom: 0;z-index: 1000;}
   #form-module * {border-radius: 0 !important;}
   #form-module .form-group {padding: 0;}
   .fa-spinner {display: none;}
   body.wait_for_ajax .fa-spinner {display: block;}
   body.wait_for_ajax .fa-check {display: none;}
</style>
{{ footer }}