<div class="sp_in_block">
    <div class="sp_right_btn_block" style="margin-top:20px;justify-content:space-between;align-items:center;">
        <div class="sppg_title" style="margin:0;">{{ txt_col_assoc_characteristics }}</div>
        <input type="checkbox" id="master-checkbox" onclick="toggleCheckboxes()" style="display: none" checked>
        <label class="sp_right_btn" for="master-checkbox" style="position:relative;margin-top:0;margin-bottom:10px;float:right;">{{ txt_btn_attr_toggle }}</label>
    </div>
    <table class="sp_groups_table attributes">
        <thead role="rowgroup">
        <tr role="row" class="sp_groups_table__header-row">
            <th role="columnheader" class="sp_groups_table__header-cell">{{ txt_col_assoc_characteristics }}</th>
            <th role="columnheader" class="sp_groups_table__header-cell text-center" style="width:400px;">{{ txt_col_custom_type }}</th>
            <th role="columnheader" class="sp_groups_table__header-cell text-center" style="width:400px;">{{ txt_col_custom_type_cat }}</th>
            <th role="columnheader" class="sp_groups_table__header-cell text-center" style="width:200px;">{{ txt_col_status }}</th>
        </tr>
        </thead>
        <tbody>
        {% if attributes %}
            {% for attribute in attributes %}
                <tr>
                    <td class="text-left">{{ attribute.name }}</td>
                    <td class="text-center">
                        <div class="snp_select" style="max-width:190px;margin:0 auto;padding:0;">
                            <div class="snp_select_sub" style="border-top:0;">
                                <select name="product_group[attribute_type][{{ attribute.attribute_id }}]" id="input-type" class="snp_select_select" style="font-size:13px">
                                    <option value="" {% if attribute.type == '' %}selected="selected"{% endif %}>{{ txt_group_type }}</option>
                                    <option value="text" {% if attribute.type == 'text' %}selected="selected"{% endif %}>{{ txt_group_type_text }}</option>
                                    <option value="color" {% if attribute.type == 'color' %}selected="selected"{% endif %}>{{ txt_group_type_color }}</option>
                                    <option value="product" {% if attribute.type == 'product' %}selected="selected"{% endif %}>{{ txt_group_type_product }}</option>
                                    <option value="select" {% if attribute.type == 'select' %}selected="selected"{% endif %}>{{ txt_group_type_select }}</option>
                                </select>
                                <span class="snp_select_span">
                                    <span class="snp_select_span_arrow"><svg><use xlink:href="#sp-icon-arrow-down"></use></svg></span>
                                </span>
                            </div>
                        </div>
                    </td>
                    <td class="text-center">
                        <div class="snp_select" style="max-width:190px;margin:0 auto;padding:0;">
                            <div class="snp_select_sub" style="border-top:0;">
                                <select name="product_group[attribute_type_cat][{{ attribute.attribute_id }}]" id="input-type-cat" class="snp_select_select" style="font-size:13px">
                                    <option value="" {% if attribute.type_cat == '' %}selected="selected"{% endif %}>{{ txt_group_type_none }}</option>
                                    <option value="text" {% if attribute.type_cat == 'text' %}selected="selected"{% endif %}>{{ txt_group_type_text }}</option>
                                    <option value="color" {% if attribute.type_cat == 'color' %}selected="selected"{% endif %}>{{ txt_group_type_color }}</option>
                                    <option value="product" {% if attribute.type_cat == 'product' %}selected="selected"{% endif %}>{{ txt_group_type_product }}</option>
                                    <option value="select" {% if attribute.type_cat == 'select' %}selected="selected"{% endif %}>{{ txt_group_type_select }}</option>
                                </select>
                                <span class="snp_select_span">
                                    <span class="snp_select_span_arrow"><svg><use xlink:href="#sp-icon-arrow-down"></use></svg></span>
                                </span>
                            </div>
                        </div>
                    </td>
                    <td class="text-center">
                        <div class="switch-box vertical" style="margin: 0">
                            <label class="input-switch" data-toggle="tooltip" title="{{ txt_status }}: {{ attribute.name }}">
                                <input type="checkbox" name="product_group[enabled_attribute][]" value="{{ attribute.attribute_id }}" {% if not attribute.disabled %} checked {% endif %}>
                            </label>
                        </div>
                    </td>
                </tr>
            {% endfor %}
        {% else %}
            <tr><td class="text-center" colspan="2">{{ txt_col_no_assoc_characteristics }}</td></tr>
        {% endif %}
        </tbody>
    </table>
</div>

<div class="sp_in_block product-group-products">
    {% set product_count = 0 %}
    {% set product_count = product_count + 1 %}
    <div class="sp_right_btn_block">
        <input type="radio" name="product_group[main_product]" id="product-group-main-product-0" value="" style="display:none" {% if not main_product %} checked {% endif %}>
    </div>
    <table class="sp_groups_table">
        <thead role="rowgroup">
        <tr role="row" class="sp_groups_table__header-row">
            <th role="columnheader" class="sp_groups_table__header-cell text-center" style="max-width:105px;">{{ txt_col_main }}</th>
            <th role="columnheader" class="sp_groups_table__header-cell">{{ txt_col_name_product }}</th>
            <th role="columnheader" class="sp_groups_table__header-cell text-center">{{ txt_col_category }}</th>
            <th role="columnheader" class="sp_groups_table__header-cell text-center">{{ txt_col_price }}</th>
            <th role="columnheader" class="sp_groups_table__header-cell text-center">{{ txt_col_sort_order }}</th>
            <th role="columnheader" class="sp_groups_table__header-cell text-center" style="max-width:60px;">{{ txt_col_actions }}</th>
        </tr>
        </thead>
        <tbody>
        {% for product in products %}
            <tr class="group-product-{{ product.product_id }}{% if product.current_product %} first-product{% endif %}">
                <td class="text-center">
                    <div class="switch-box vertical" style="margin:0;margin-top:4px;">
                        <label class="input-switch-two" data-toggle="tooltip" title="{{ txt_col_main }}">
                            <input type="radio" name="product_group[main_product]" value="{{ product.product_id }}" {% if product.main_product %} checked {% endif %}>
                            <label for="product-group-main-product-0" class="input-switch-two-toogle"></label>
                        </label>
                    </div>
                </td>
                <td class="text-left">
                    <div class="sp_mass_product_list_product_info">
                        <a href="" id="thumb-image-{{ product.product_id }}" data-toggle="image" class="sp_product_container_image">
                            <img src="{{ product.custom_image_thumb }}" alt="" title="" data-placeholder="{{ product.placeholder }}" style="max-width:60px;max-height:60px;">
                        </a>
                        <input type="hidden" name="product_group[products][{{ product.product_id }}][attr_image]" value="{{ product.custom_image }}" id="input-image-{{ product.product_id }}">
                        <span class="sp_product_container_name"><span>{{ product.name }} <a href="{{ product.edit }}" data-toggle="tooltip" target="_blank" title="{{ txt_edit }}" class="sppg_btn_edit"><svg><use xlink:href="#pen"></use></svg></a></span><span class="sp_product_container_model">{{ txt_model }}:&nbsp;{{ product.model }}</span></span>
                    </div>
                </td>
                <td class="text-center">{% if product.category %}{{ product.category }}{% else %}{{ txt_no_category }}{% endif %}</td>
                <td class="text-center">{{ product.price }}</td>
                <td class="text-center">
                    <div class="sp_animated_input_group" style="max-width:80px;margin:0 auto;">
                        <input id="input-sorting" type="text" name="product_group[products][{{ product.product_id }}][sort_order]" value="{{ product.sort_order }}" class="profile-form-input sp_scrollable_block_input" style="text-align:center;">
                        <label for="input-sorting" class="label"></label>
                        <span class="bar"></span>
                    </div>
                </td>
                <td class="text-center">
                    <button type="button" data-toggle="tooltip" title="{{ txt_delete }}" onclick="$('.sp_groups_table .group-product-{{ product.product_id }}').remove();checkProductTableFoot();" class="sppg_btn_delete"><svg><use xlink:href="#trash"></use></svg></button>
                </td>
            </tr>
        {% endfor %}
        </tbody>
        <tfoot>
        <tr>
            <td class="text-right" colspan="7" style="padding:20px;">
                <div class="sp_group_products_bottom_buttons">
                    <button type="button" class="sp_button_success button-add-products-to-group" >{{ txt_btn_save }}</button>
                    <button type="button" class="sp_button_danger button-remove-products-from-group">{{ txt_btn_delete_compare }}</button>
                </div>
            </td>
        </tr>
        </tfoot>
    </table>
</div>


<script>
    function toggleCheckboxes() {
        var checkboxes = document.querySelectorAll('.switch-box input[type="checkbox"]');
        var masterCheckbox = document.getElementById('master-checkbox');
        checkboxes.forEach(function(checkbox) {
            checkbox.checked = masterCheckbox.checked;
        });
    }
</script>
