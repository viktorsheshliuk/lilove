<script>
    $(".spectrum").spectrum({
        preferredFormat: "rgb",
        showInitial: true,
        showInput: true,
        showAlpha: true,
        showPalette: false,
        palette: [['#1abc9c','#16a085','#2ecc71','#27ae60']]
    });
</script>
{{ footer }}