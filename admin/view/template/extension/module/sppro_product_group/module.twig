                                </div>

                                <div class="switch-box full_width">
                                    <div class="title">{{ txt_in_search }}</div>
                                    <label class="input-switch">
                                        <input type="checkbox" name="module_sppro_product_group_main_search" {% if module_sppro_product_group_main_search %} checked {% endif %}>
                                    </label>
                                </div>
                                <div class="switch-box full_width">
                                    <div class="title">{{ txt_in_manufacturer }}</div>
                                    <label class="input-switch">
                                        <input type="checkbox" name="module_sppro_product_group_main_manufatcurer" {% if module_sppro_product_group_main_manufatcurer %} checked {% endif %}>
                                    </label>
                                </div>
