{{ header }}{{ column_left }}
<div class="sp sp_in_module" id="content">
    <div class="header_module_info">
        <div class="title">{{ heading_title }} <span id="version"></span></div>
        <div class="buttons">
            <button type="submit" form="form-module" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-save"><i class="fa fa-save"></i></button>
            <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-close"><i class="fa fa-reply"></i></a>
        </div>
    </div>

    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-module" class="form-horizontal">
        <div class="module_form" id="form-module-block">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" class="active"><a href="#main" aria-controls="main" role="tab" data-toggle="tab">{{ txt_tab_main }}</a></li>
                {% if license_status %}
                    {% if not error_license %}
                        <li role="presentation"><a href="#styles" aria-controls="styles" role="tab" data-toggle="tab">{{ txt_tab_style_setting }}</a></li>
                        <li role="presentation"><a href="#groups" aria-controls="groups" role="tab" data-toggle="tab">{{ txt_tab_groups_of_products }}</a></li>
                        <li role="presentation"><a href="#grouped_product" aria-controls="grouped_product" role="tab" data-toggle="tab">{{ txt_tab_adding_products_to_groups }}</a></li>
                        <li role="presentation"><a href="#auto_grouped_product" aria-controls="auto_grouped_product" role="tab" data-toggle="tab">{{ txt_tab_auto_grouped_product }}</a></li>
                    {% endif %}
                {% endif %}
            </ul>

            <div class="tab-content">
                <div role="tabpanel" class="tab-pane active" id="main">
                    <div class="single_block">
                        <div class="title">{{ txt_module_settings }}</div>
                        <div class="switch-box full_width">
                            <div class="title">{{ txt_status }}</div>
                            <label class="input-switch">
                                <input type="checkbox" name="module_sppro_product_group_status" {% if module_sppro_product_group_status %} checked {% endif %}>
                            </label>
                        </div>

                        <div class="sp_animated_input_group">
                            <input id="input-license" type="text" name="module_sppro_product_group_license" placeholder="{{ txt_license_key }}" value="{{ module_sppro_product_group_license }}" class="profile-form-input {% if error_license %} error_style {% endif %}">
                            <label for="input-license" class="label">{{ txt_license_key }}</label>
                            <span class="bar"></span>
                            {% if error_license %}
                                <div class="error_style_text">{{ error_license }}</div>
                            {% endif %}
                        </div>
                    </div>

                    {% if license_status %}
                        {% if not error_license %}
                            <div class="single_block">
                                <div class="title">{{ txt_visible_main_product }}</div>

                                <div class="switch-box full_width">
                                    <div class="title">{{ txt_in_category }}</div>
                                    <label class="input-switch">
                                        <input type="checkbox" name="module_sppro_product_group_main_category" {% if module_sppro_product_group_main_category %} checked {% endif %}>
                                    </label>
                                </div>

                                <div class="title title_helper" style="margin-bottom: 10px !important;">{{ txt_category_list }}<a class="info"><svg><use xlink:href="#sp-icon-info"></use></svg><span class="info-content">{{ txt_category_list_help }}</span></a></div>

                                <div class="sp_animated_input_group" style="margin-top: 20px;">
                                    <input id="sp_scrollable_block_input" type="text" placeholder="{{ txt_enter_cate_name }}" class="profile-form-input sp_scrollable_block_input">
                                    <label for="sp_scrollable_block_input" class="label">{{ txt_enter_cate_name }}</label>
                                    <span class="bar"></span>
                                </div>

                                <div class="sp_scrollable_block_input_hr"></div>

                                <div class="sp_scrollable_block sp_scrollable_block_attr">
                                    {% for category in categories %}
                                        <div class="sp_checkbox full_width sp_category_list_item">
                                            <label><input type="checkbox" name="module_sppro_product_group_main_category_list[]" value="{{ category.category_id }}" {% if category.category_id in module_sppro_product_group_main_category_list %} checked {% endif %}>{{ category.name }}</label>
                                        </div>
                                    {% endfor %}
