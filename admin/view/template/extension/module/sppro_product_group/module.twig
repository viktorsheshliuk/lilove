                                    <label class="input-switch">
                                        <input type="checkbox" name="module_sppro_product_group_shema" {% if module_sppro_product_group_shema %} checked {% endif %}>
                                    </label>
                                </div>

                                <div class="switch-box full_width">
                                    <div class="title">{{ txt_canonical }}<a class="info"><svg><use xlink:href="#sp-icon-info"></use></svg><span class="info-content">{{ txt_canonical_info }}</span></a></div>
                                    <label class="input-switch">
                                        <input type="checkbox" name="module_sppro_product_group_canonical" {% if module_sppro_product_group_canonical %} checked {% endif %}>
                                    </label>
                                </div>
                            </div>

                            <div class="single_block">
                                <div class="title">{{ txt_ajax }}</div>

                                <div class="switch-box full_width">
                                    <div class="title">{{ txt_ajax_product_page }}</div>
                                    <label class="input-switch">
                                        <input type="checkbox" name="module_sppro_product_group_ajax_product_page" {% if module_sppro_product_group_ajax_product_page %} checked {% endif %}>
                                    </label>
                                </div>

                                <div class="switch-box full_width">
                                    <div class="title">{{ txt_ajax_in_category }}</div>
                                    <label class="input-switch">
                                        <input type="checkbox" name="module_sppro_product_group_ajax_in_category" {% if module_sppro_product_group_ajax_in_category %} checked {% endif %}>
                                    </label>
                                </div>
                            </div>
                        {% endif %}
                    {% endif %}
                </div>
                <div role="tabpanel" class="tab-pane" id="styles">
                    <div class="single_block">
                        <div class="title">{{ txt_setting_style }}</div>

                        <div class="sp_space_between_color">
