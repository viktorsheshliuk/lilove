                                                <svg>
                                                    <use xlink:href="#pen"></use>
                                                </svg>
                                            </a>
                                            <a href="{{ group.remove }}" onclick="return confirm('{{ notify_alert_message }}');" data-toggle="tooltip" title="{{ txt_delete }}" class="sppg_btn_delete">
