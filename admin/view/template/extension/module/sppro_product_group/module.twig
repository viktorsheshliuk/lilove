                        </div>
                    </div>

                    <div class="single_block_btns">
                        <button type="button" onclick="updateAutoGroup('autoGroupRemove');" class="sp_button_danger button-add-products-to-group" >{{ txt_delete_connections }}</button>
                        <button type="button" onclick="updateAutoGroup('autoGroupSet');" class="sp_button_success button-remove-products-from-group">{{ txt_connection }}</button>
                    </div>
                </div>
            </div>
        </div>
