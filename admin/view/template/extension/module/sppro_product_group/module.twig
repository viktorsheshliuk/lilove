<script>
    function catSelected(block, status) {
        var checkboxes = document.querySelectorAll('.'+block+' input[type="checkbox"]');
        checkboxes.forEach(function(checkbox) {
            checkbox.checked = status;
        });
    }

    function getSearchList() {
        const inputField_one = document.querySelector(".sp_scrollable_block_input");
        const checkboxes_one = document.querySelectorAll(".sp_scrollable_block_attr > .sp_checkbox");

        inputField_one.addEventListener("input", function() {
            const searchText = this.value.toLowerCase();
            checkboxes_one.forEach(function(checkbox) {
                const label = checkbox.querySelector("label").textContent.toLowerCase();
                if (label.includes(searchText)) {
                    checkbox.classList.remove("hidden");
                } else {
                    checkbox.classList.add("hidden");
                }
            });
        });
    }
</script>

<script>
    function autoOffAttributes() {
        var checkboxes = document.querySelectorAll('#auto-group-attributes-list input[type="checkbox"]');
        checkboxes.forEach(function(checkbox) {
            checkbox.checked = false;
        });
    }
    function autoOnAttributes() {
        var checkboxes = document.querySelectorAll('#auto-group-attributes-list input[type="checkbox"]');
        checkboxes.forEach(function(checkbox) {
            checkbox.checked = true;
        });
    }
</script>

<div class="sp_notify_block"></div>

<script>
    function spNotify(type, text) {
        var icon = "fa fa-info";
        var css = "";
        switch (type) {
            case"success":
                icon = "sp-icon-notify-success";
                css = "success";
                break;
            case"danger":
                icon = "sp-icon-notify-danger";
                css = "warning";
                break;
            case"warning":
                icon = "sp-icon-notify-warning"
                css = "warning"
        }
        var randomNumber = Math.floor(Math.random() * 100);
        $('.sp_notify_block').append('<div id="sp_alert_' + randomNumber + '" class="sp_notify_alert ' + css + '"><div class="sp_notify_alert__icon"><svg><use xlink:href="#' + icon + '"></use></svg></div><div class="sp_notify_alert__message">' + text + '</div></div>');
        setTimeout(function () {
            $('#sp_alert_' + randomNumber).addClass('hide');
            setTimeout(function () {
                $('#sp_alert_' + randomNumber).remove();
            }, 2000);
        }, 5000);
    }
</script>

{% if error_warning %}
    <script>
        spNotify('warning', '{{ error_warning }}');
    </script>
{% endif %}

{% if success %}
    <script>
        spNotify('success', '{{ success }}');
    </script>
{% endif %}

<script>
    $('#sppro-product-auto-group-categories').multiselect({
            texts: {
                placeholder: '{{ txt_select_category }}',
                selectedOptions: ' {{ txt_selected }}',
            }
        }
    );
    $('#sppro-product-auto-group-manufacturers').multiselect({
            texts: {
                placeholder: '{{ txt_select_manufacturer }}',
                selectedOptions: ' {{ txt_selected }}',
            }
        }
    );

    function loadAutoGroupAttributes() {
        $('#auto-group-attributes-list').html('');
        $.ajax({
            url: 'index.php?route=extension/module/sppro_product_group/autoGroupGetAttributes&user_token={{ user_token }}',
            data: $('#form-module').serialize(),
            type: 'post',
            dataType: 'json',
            success: function (json) {
                $('.sppro-product-auto-group-loader-attributes').remove();
                if (json['attributes'].length) {
                    for (i in json['attributes']) {
                        attribute_html = ' <div class="sp_checkbox full_width"><label>';
                        attribute_html += '<input type="checkbox" name="module_sppro_product_group_auto_setting[attributes][' + json['attributes'][i]['attribute_id'] + ']"';
                        if (json['attributes'][i]['checked']) {
                            attribute_html += ' checked="checked"';
                        }
                        attribute_html += '>';
                        attribute_html += json['attributes'][i]['name'];
                        attribute_html += '</label></div>';
                        $('#auto-group-attributes-list').append(attribute_html);
                    }
                    getSearchList();
                } else {
                    $('#auto-group-attributes-list').text('{{ txt_attributes_not_found }}');
                }
            }
        });
    }

    function updateAutoGroup(method) {
        $('.alert').remove();
        $('.sppro-product-auto-group-buttons').after('<div class="sppro-product-auto-group-loader sppro-product-auto-group-loader-set">{{ txt_wait_dots }}</div>');
        $.ajax({
            url: 'index.php?route=extension/module/sppro_product_group/' + method + '&user_token={{ user_token }}',
            data: $('#form-module').serialize(),
            type: 'post',
            dataType: 'json',
            success: function (json) {
                if (json['success']) {
                    $('.sppro-product-auto-group-loader-set').remove();
                    spNotify('success', json['success']);
                }
                if (json['error']) {
                    $('.sppro-product-auto-group-loader-set').remove();
                    spNotify('warning', json['error']);
                }
            }
        });
    }

    loadAutoGroupAttributes();
    $('#sppro-product-auto-group-categories, #sppro-product-auto-group-manufacturers').on('change', loadAutoGroupAttributes);
</script>

<script>
    $(".spectrum").spectrum({
        preferredFormat: "rgb",
        showInitial: true,
        showInput: true,
        showAlpha: true,
        showPalette: false
    });
</script>

