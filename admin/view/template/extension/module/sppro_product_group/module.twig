                        <table class="sp_groups_table">
                            <thead role="rowgroup">
                            <tr role="row" class="sp_groups_table__header-row">
                                <th role="columnheader" class="sp_groups_table__header-cell">{{ txt_col_name_product }}</th>
                                <th role="columnheader" class="sp_groups_table__header-cell">{{ txt_col_attributes }}</th>
                                <th role="columnheader" class="sp_groups_table__header-cell">{{ txt_col_type }}</th>
                                <th role="columnheader" class="sp_groups_table__header-cell">{{ txt_col_hint_when_hovering }}</th>
                                <th role="columnheader" class="sp_groups_table__header-cell">{{ txt_col_sort_order }}</th>
                                <th role="columnheader" class="sp_groups_table__header-cell">{{ txt_col_categorization }}</th>
