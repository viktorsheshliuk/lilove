                            <div><input type="text" class="spectrum" data-coloris name="module_sppro_product_group_styles[background_color_selected_s]" value="{{ module_sppro_product_group_styles.background_color_selected_s }}"></div>
                        </div>

                        <div class="sp_space_between_color">
                            <div class="sp_space_between_color_title">{{ txt_background_color_hover_s }}</div>
                            <div><input type="text" class="spectrum" data-coloris name="module_sppro_product_group_styles[background_color_hover_s]" value="{{ module_sppro_product_group_styles.background_color_hover_s }}"></div>
