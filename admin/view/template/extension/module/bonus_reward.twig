<script>
  document.addEventListener("DOMContentLoaded", function() {
    document.querySelectorAll(".copy-link").forEach(link => {
      link.addEventListener("click", function(event) {
        event.preventDefault();
        var temp = document.createElement("textarea");
        temp.value = this.textContent.trim();
        document.body.appendChild(temp);
        temp.select();
        document.execCommand("copy");
        document.body.removeChild(temp);
        alert("{{ text_copy }}");
      });
    });
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const categorySelect = $('#input-category');
    const categoryTableBody = document.querySelector('#category-table-container tbody');
    const tableContainer = document.querySelector('#category-table-container');

    function toggleTableVisibility() {
      if (categoryTableBody.querySelector('tr')) {
        tableContainer.style.display = 'block';
      } else {
        tableContainer.style.display = 'none';
      }
    }

    categorySelect.on('changed.bs.select', function () {
      const selectedOptions = Array.from(categorySelect[0].selectedOptions);
      selectedOptions.forEach(option => {
        const categoryId = option.value;
        const categoryName = option.text;

        if (categoryTableBody.querySelector(`tr[data-category-id="${categoryId}"]`)) {
          return;
        }

        const row = document.createElement('tr');
        row.setAttribute('data-category-id', categoryId);

        let coefficientInput = `<td>
          <input type="text" class="form-control" 
                 name="module_bonus_reward_category[${categoryId}][coefficient]" 
                 value="" />
        </td>`;

        let inputFields = '';
        {% for customer_group in customer_groups %}
          inputFields += `  
            <td>
              <input type="text" class="form-control" 
                     name="module_bonus_reward_category[${categoryId}][customer_group][{{ customer_group.customer_group_id }}]" 
                     value="" />
            </td>
          `;
        {% endfor %}

        row.innerHTML = `
          <td class="cat">${categoryName}</td>
          {% if module_bonus_reward_method == 'standard' %}${coefficientInput}{% endif %}
          ${inputFields}
          <td class="rm">
            <button type="button" class="btn btn-danger">
              <i class="fa fa-minus-circle"></i>
            </button>
          </td>
        `;

        categoryTableBody.appendChild(row);

        categorySelect.selectpicker('refresh');

        toggleTableVisibility();
      });
    });

    categoryTableBody.addEventListener('click', function (e) {
      if (e.target.closest('.btn-danger')) {
        const row = e.target.closest('tr');
        const categoryId = row.getAttribute('data-category-id');

        const option = categorySelect.find(`option[value="${categoryId}"]`)[0];
        if (option) {
          option.selected = false;

          categorySelect.selectpicker('refresh');
        }

        row.remove();

        toggleTableVisibility();
      }
    });

    categorySelect.on('change', function () {
      const selectedOptions = Array.from(categorySelect[0].selectedOptions).map(option => option.value);

      const rows = categoryTableBody.querySelectorAll('tr');

      rows.forEach(row => {
        const categoryId = row.getAttribute('data-category-id');
        if (!selectedOptions.includes(categoryId)) {
          row.remove();
        }
      });

      toggleTableVisibility();
    });

    toggleTableVisibility();
  });
</script>
