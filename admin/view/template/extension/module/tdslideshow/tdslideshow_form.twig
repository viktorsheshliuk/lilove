{{header}}{{column_left}}
{% set token_random = random() %}
<div id="content">
	<div class="page-header">
		<div class="container-fluid">
			<div class="pull-right">
				<button type="submit" form="form-html" data-toggle="tooltip" title="{{button_save}}" class="btn btn-primary"><i class="fa fa-save"></i></button>
				<a href="{{cancel}}" data-toggle="tooltip" title="{{button_cancel}}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
				<h1>{{heading_title}}</h1>
				<ul class="breadcrumb">
					{% for breadcrumb in breadcrumbs %}
					<li><a href="{{breadcrumb.href}}">{{breadcrumb.text}}</a></li>
					{% endfor %}
				</ul>
			</div>
	</div>
	<div class="container-fluid">
		{% if error_warning %}
		<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{error_warning}}
			<button type="button" class="close" data-dismiss="alert">&times;</button>
		</div>
		{% endif %}
		<div class="panel panel-default custom-panel">
			<div class="panel-heading">
				<h3 class="panel-title"><i class="fa fa-pencil"></i> {{text_edit}}</h3>
			</div>
		    <div class="panel-body">
					<form action="{{action}}" method="post" enctype="multipart/form-data" id="form-module" class="form-horizontal">
						<div class="form-group">
							<label class="control-label" for="input-name">{{entry_name}}</label>
							<div class="control-group">
								<input type="text" name="name" value="{{name}}" placeholder="{{entry_name}}" id="input-name" class="form-control" />
								{% if error_name %}
								<div class="text-danger">{{error_name}}</div>
								{% endif %}
							</div>
						</div>
						<div class="form-group">
							<label class="control-label" for="input-effect">{{entry_effect}}</label>
							<div class="control-group">
								<select name="effect" id="input-effect" class="form-control">
									{% for effect1 in effect_option %}
									<option  {% if  effect1['value'] | trim == effect | trim %}  selected ="selected"  {% endif %}  value="{% if  effect1['value'] %}  {{effect1['label']}}  {% endif %}">{% if  effect1['value'] %}  {{effect1['label']}}  {% endif %} </option>
									{% endfor %}
								</select>
							</div>
						</div>
						<div class="form-group required">
							<label class="control-label" for="input-delay">{{entry_delay}}</label>
							<div class="control-group">
								<input type="text" name="delay" value="{{delay}}" placeholder="{{entry_delay}}" id="input-delay" class="form-control" />
								{% if error_delay %}
								<div class="text-danger">{{error_delay}}</div>
								{% endif %}
							</div>
						</div>
						<div class="form-group" >
							<label class="control-label" for="input-auto">{{entry_auto}}</label>
							<div class="control-group">
								<div class="switch-field">
									<input type="radio" name="auto" id="auto_on" value="1" {% if auto == 1 %} checked="checked" {% endif %}/>
									<label for="auto_on">{{ text_enabled }}</label>
									<input type="radio" name="auto" id="auto_off" value="0" {% if auto == 0 %} checked="checked" {% endif %}/>
									<label for="auto_off">{{ text_disabled }}</label>
								</div>
							</div>
						</div>
						<div class="form-group">
							<label class="control-label" for="input-hover">{{entry_hover}}</label>
							<div class="control-group">
								<div class="switch-field">
									<input type="radio" name="hover" id="hover_on" value="1" {% if hover == 1 %} checked="checked" {% endif %}/>
									<label for="hover_on">{{ text_enabled }}</label>
									<input type="radio" name="hover" id="hover_off" value="0" {% if hover == 0 %} checked="checked" {% endif %}/>
									<label for="hover_off">{{ text_disabled }}</label>
								</div>
							</div>
						</div>
						<div class="form-group">
							<label class="control-label" for="input-nextback">{{entry_nextback}}</label>
							<div class="control-group">
								<div class="switch-field">
									<input type="radio" name="nextback" id="nextback_on" value="1" {% if nextback == 1 %} checked="checked" {% endif %}/>
									<label for="nextback_on">{{ text_enabled }}</label>
									<input type="radio" name="nextback" id="nextback_off" value="0" {% if nextback == 0 %} checked="checked" {% endif %}/>
									<label for="nextback_off">{{ text_disabled }}</label>
								</div>
							</div>
						</div>
						<div class="form-group">
							<label class="control-label" for="input-contrl">{{entry_contrl}}</label>
							<div class="control-group">
								<div class="switch-field">
									<input type="radio" name="contrl" id="contrl_on" value="1" {% if contrl == 1 %} checked="checked" {% endif %}/>
									<label for="contrl_on">{{ text_enabled }}</label>
									<input type="radio" name="contrl" id="contrl_off" value="0" {% if contrl == 0 %} checked="checked" {% endif %}/>
									<label for="contrl_off">{{ text_disabled }}</label>
								</div>
							</div>
						</div>
						<div class="form-group">
							<label class="control-label" for="input-status">{{entry_status}}</label>
							<div class="control-group">
								<div class="switch-field">
									<input type="radio" name="status" id="status_on" value="1" {% if status == 1 %} checked="checked" {% endif %}/>
									<label for="status_on">{{ text_enabled }}</label>
									<input type="radio" name="status" id="status_off" value="0" {% if status == 0 %} checked="checked" {% endif %}/>
									<label for="status_off">{{ text_disabled }}</label>
								</div>
							</div>
						</div>
						<div class="row">
							<div class="col-sm-2">
								<ul class="nav nav-pills nav-stacked" id="module">
									{% set module_row = 0 %}
									{% for tdslideshow_image in  tdslideshow_images %}
									<li><a href="#tab-module{{tdslideshow_image['key']}}" data-toggle="tab"><i class="fa fa-minus-circle" onclick="$('a[href=\'#tab-module{{tdslideshow_image['key']}}\']').parent().remove(); $('#tab-module{{tdslideshow_image['key']}}').remove(); $('#module a:first').tab('show');"></i> {{tab_banner}}  {{module_row}}</a></li>
									{% set module_row = module_row +1 %}
									{% endfor %}
									<li id="module-add"><a onclick="addModule();"><i class="fa fa-plus-circle"></i> {{button_add_banner}}</a></li>
								</ul>
							</div>
							<div class="col-sm-10">
								<div class="tab-content">
									{% set  image_row = 0 %}
									{% for tdslideshow_image in  tdslideshow_images %}
									<div class="tab-pane" id="tab-module{{tdslideshow_image['key']}}">
										<ul class="nav nav-tabs" id="language{{tdslideshow_image['key']}}">
											{% for language in  languages %}
											<li><a href="#tab-module{{tdslideshow_image['key']}}-language{{language['language_id']}}" data-toggle="tab"><img src="language/{{language['code']}}/{{language['code']}}.png" title="{{language['name']}}" /> {{language['name']}}</a></li>
											{% endfor %}
										</ul>

										<div class="tab-content">
											{% for language in  languages %}
											<div class="tab-pane" id="tab-module{{tdslideshow_image['key']}}-language{{language['language_id']}}">

												<div class="form-group">
													<label class="control-label" for="input-title{{tdslideshow_image['key']}}-language{{language['language_id']}}">{{entry_title}}</label>
													<div class="control-group">
														<input type="text" id="input-title{{tdslideshow_image['key']}}-language{{language['language_id']}}" name="tdslideshow_image[{{image_row}}][tdslideshow_image_description][{{language['language_id']}}][title]" value="{% if tdslideshow_image['tdslideshow_image_description'][language['language_id']] %}{{tdslideshow_image['tdslideshow_image_description'][language['language_id']]['title']}}{% else %}{% endif %}" placeholder="{{entry_title}}" class="form-control" />
													</div>
												</div>
											</div>
											{% endfor %}
											<div class="form-group">
												<label class="control-label" for="input-link{{tdslideshow_image['key']}}-language{{language['language_id']}}">{{entry_link}}</label>
												<div class="control-group">
													<input type="text" id="input-link{{tdslideshow_image['key']}}-language{{language['language_id']}}" name="tdslideshow_image[{{image_row}}][link]" value="{% if  tdslideshow_image['link'] %}{{tdslideshow_image['link']}} {% endif %}" placeholder="{{entry_link}}" class="form-control" />
												</div>
											</div>
											<div class="form-group">
												<label class="control-label" for="thumb-image-{{tdslideshow_image['key']}}-{{token_random}}">{{entry_image}}</label>
												<div class="control-group">
													<a href="" id="thumb-image-{{tdslideshow_image['key']}}-{{token_random}}" data-toggle="image" class="img-thumbnail"><img src="{% if tdslideshow_image['thumb'] %} {{tdslideshow_image['thumb']}} {% else %}  {{placeholder}} {% endif %}" alt="" title="" data-placeholder="{{placeholder}}" /></a>
													<input type="hidden"  name="tdslideshow_image[{{image_row}}][image]"  value="{{tdslideshow_image['image']}}" id="input-image{{tdslideshow_image['key']}}-{{token_random}}" />
												</div>
											</div>

											<div class="form-group" style="display: none">
												<label class="control-label" for="thumb-image-{{tdslideshow_image['key']}}-{{token_random +1}}">{{entry_small_image}}</label>
												<div class="control-group">
													<a href="" id="thumb-image-{{tdslideshow_image['key']}}-{{token_random +1}}" data-toggle="image" class="img-thumbnail"><img src="{% if tdslideshow_image['small_thumb'] %} {{tdslideshow_image['small_thumb']}} {% else %}  {{placeholder}} {% endif %}" alt="" title="" data-placeholder="{{placeholder}}" /></a>
													<input type="hidden"  name="tdslideshow_image[{{image_row}}][small_image]"  value="{{tdslideshow_image['small_image']}}" id="input-image{{tdslideshow_image['key']}}-{{token_random +1}}" />
												</div>
											</div>
											<div class="form-group">
												<label class="control-label">{{entry_store }}</label>
												<div class="control-group">
													<div class="well well-sm" style="height: 150px; overflow: auto;">
														{% for store in stores %}
														<div class="checkbox">
															<label>
																<input type="checkbox" name="banner_store[]" value="{{store['store_id'] }}" {% if store['store_id'] in tdslideshow_image['banner_store'] %}  checked="checked" {% endif %}  />
																{{store['name'] }}
															</label>
														</div>
														{% endfor %}
													</div>
												</div>
											</div>
										</div>
									</div>
									{%set image_row = image_row+1%}
									{% endfor %}
								</div>
							</div>
						</div>
				   </form>
			</div>
		</div>
	 </div>
</div>
<script type="text/javascript" src="view/javascript/summernote/summernote.js"></script>
<link href="view/javascript/summernote/summernote.css" rel="stylesheet" />
<script type="text/javascript" src="view/javascript/summernote/summernote-image-attributes.js"></script>
<script type="text/javascript" src="view/javascript/summernote/opencart.js"></script>
<script type="text/javascript"><!--
var module_row = {{module_row}};

function addModule() {
	var token = Math.random().toString(36).substr(2);

	html  = '<div class="tab-pane" id="tab-module' + token + '">';
	html += '  <ul class="nav nav-tabs" id="language' + token + '">';
	{% for language in  languages %}
	html += '    <li><a href="#tab-module' + token + '-language{{language['language_id']}}" data-toggle="tab"><img src="language/{{language['code']}}/{{language['code']}}.png" title="{{language['name']}}" /> {{language['name']}}</a></li>';
	{% endfor %}
	html += '  </ul>';
	html += '  <div class="tab-content">';
	{% for language in  languages %}
	html += '    <div class="tab-pane" id="tab-module' + token + '-language{{language['language_id']}}">';
	html += '      <div class="form-group">';
	html += '        <label class="control-label" for="input-title' + token + '-language{{language['language_id']}}">{{entry_title}}</label>';
	html += '        <div class="control-group"><input type ="text" name="tdslideshow_image[' + token + '][tdslideshow_image_description][{{language['language_id']}}][title]"placeholder="{{entry_title}}" class="form-control" id="input-title' + token + '-language{{language['language_id']}}"/></div>';
	html += '      </div>';
	html += '    </div>';
	{% endfor %}

	html += '      <div class="form-group">';
	html += '        <label class="control-label" for="input-link' + token + '-language{{language['language_id']}}">{{entry_link}}</label>';
	html += '        <div class="control-group"><input class="form-control" type="text" name="tdslideshow_image[' + token + '][link]" placeholder="{{entry_link}}" id="input-link' + token + '-language{{language['language_id']}}"/></div>';
	html += '      </div>';

	html += '      <div class="form-group">';
	html += '        <label class="control-label" for="input-image' + token + '-language{{language['language_id']}}">{{entry_image}}</label>';

	html += '<div class="control-group"><a href="" id="thumb-image' + token + '" data-toggle="image" class="img-thumbnail"><img src="{{placeholder}}" alt="" title="" data-placeholder="{{placeholder}}" /></a><input type="hidden" name="tdslideshow_image[' + token + '][image]" value="" id="input-image' + token + '" /></div>';
	html += '      </div>';

	html += '<div class="form-group" style="display: none;">';
	html += '<label class="control-label" for="input-image">'+'{{entry_small_image}}'+'</label>';

	html += '<div class="control-group">';
	html += '<a href="" id="thumb-image-'+'{{token_random+1}}'+'" data-toggle="image" class="img-thumbnail"><img src="{{placeholder}}" alt="" title="" data-placeholder="{{placeholder}}" /></a>';
	html += '<input type="hidden"  name="tdslideshow_image['+ token +'][small_image]"  value="" id="input-image'+'{{token_random+1}}'+'" />';

	html += '</div>';
	html += '</div>';

	html +='<div class="form-group">';
	html +='<label class="control-label">{{entry_store}}</label>';
	html +='<div class="control-group">'
	html +='<div class="well well-sm" style="height: 150px; overflow: auto;">';
	{% for store in stores %}

	html +='<div class="checkbox">';
	html +='<label>';
	html +='<input type="checkbox" name="tdslideshow_image[' + token + '][banner_store][]" value="{{store['store_id']}}"  />{{store['name']}} ';
	html +='</label>';
	html +='</div>';
	{% endfor %}
	html +='</div>';
	html +='</div>';
	html +='</div>';
	html += '  </div>';
	html += '</div>';

	$('.tab-content:first-child').prepend(html);

	{% for language in  languages %}
	$('#input-description' + token + '-language{{language['language_id']}}').summernote({
		height: 300
	});
	{% endfor %}

	$('#module-add').before('<li><a href="#tab-module' + token + '" data-toggle="tab"><i class="fa fa-minus-circle" onclick="$(\'a[href=\\\'#tab-module' + token + '\\\']\').parent().remove(); $(\'#tab-module' + token + '\').remove(); $(\'#module a:first\').tab(\'show\');"></i> {{tab_banner}} ' + module_row + '</a></li>');

	$('#module a[href=\'#tab-module' + token + '\']').tab('show');

	$('#language' + token + ' li:first-child a').tab('show');

	module_row++;
}
//--></script>
<script type="text/javascript"><!--
$('#module li:first-child a').tab('show');
{% for tdslideshow_image in  tdslideshow_images %}
$('#language{{tdslideshow_image['key']}} li:first-child a').tab('show');
{% endfor %}
//--></script>
<style type="text/css">
#module-add img {display:none!important;}
</style>
{{footer}}