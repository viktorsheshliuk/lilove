{{header }} {{ column_left}}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-tdblog" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <button onclick="$('#content form #saveandstay').attr('value', '1'); $('#' + $('#content form').attr('id')).submit();" data-toggle="tooltip" title="{{ button_savestay }}" class="btn btn-warning"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="alert alert-info"><i class="fa fa-info-circle"></i> {{text_view_list}}
    </div>
    <div class="panel panel-default custom-panel">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{text_edit}}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-tdblog" class="form-horizontal">
          <input type="hidden" name="module_id" value="{{ module_id }}" />
           {# Module Name #}
          <div class="form-group">
            <label class="control-label" for="input-name">{{entry_name}}</label>
            <div class="control-group">
              <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control" />
               {% if error_name %}
              <div class="text-danger">{{ error_name }}</div>
              {% endif %}
            </div>
          </div>
          {# Module Status #}
          <div class="form-group">
            <label class="control-label" for="input-status">{{ entry_status }}</label>
            <div class="control-group">
              <div class="switch-field">
                <input type="radio" name="status" id="status_on" value="1" {% if status == 1 %} checked="checked" {% endif %}/>
                <label for="status_on">{{ text_enabled }}</label>
                <input type="radio" name="status" id="status_off" value="0" {% if status == 0 %} checked="checked" {% endif %}/>
                <label for="status_off">{{ text_disabled }}</label>
              </div>
            </div>
          </div>

          {# Blog WxH #}
          <div class="form-group">
            <label class="control-label" for="input-width"><span data-toggle="tooltip" title="{{ help_image }}">{{ entry_image_size }}</span></label>
            <div class="control-group">
              <input type="text" name="width" value="{{ width }}" placeholder="{{ entry_width }}" id="input-width" class="td-number-field form-control" />
              {% if error_width %}
              <div class="text-danger">{{ error_width }}</div>
              {% endif %}
               x
              <input type="text" name="height" value="{{ height }}" placeholder="{{ entry_height }}" id="input-height" class="td-number-field form-control" />
              {% if error_height %}
              <div class="text-danger">{{ error_height }}</div>
              {% endif %}
            </div>
          </div>

          {# limit #}
          <div class="form-group">
            <label class="control-label" for="input-limit"><span data-toggle="tooltip" title="{{ help_limit }}">{{ entry_limit }}</span></label>
            <div class="control-group">
              <input type="text" name="limit" value="{{ limit }}" placeholder="{{ entry_limit }}" id="input-limit" class="form-control" />
            </div>
          </div>

          {# Char limit #}
          <div class="form-group">
            <label class="control-label" for="input-char-limit"><span data-toggle="tooltip" title="{{ help_char_limit }}">{{ entry_char_limit }}</span></label>
            <div class="control-group">
              <input type="text" name="char_limit" value="{{ char_limit }}" placeholder="{{ entry_char_limit }}" id="input-char-limit" class="form-control" />
            </div>
          </div>

            {# Navigation #}
            <div class="form-group">
              <label class="control-label" for="input-navigation">{{ entry_navigation }}</label>
              <div class="control-group">
                <div class="switch-field">
                  <input type="radio" name="navigation" id="navigation_on" value="1" {% if navigation == 1 %} checked="checked" {% endif %}/>
                  <label for="navigation_on">{{ text_enabled }}</label>
                  <input type="radio" name="navigation" id="navigation_off" value="0" {% if navigation == 0 %} checked="checked" {% endif %}/>
                  <label for="navigation_off">{{ text_disabled }}</label>
                </div>
              </div>
            </div>

            {# Pagination #}
            <div class="form-group">
              <label class="control-label" for="input-pagination">{{ entry_pagination }}</label>
              <div class="control-group">
                <div class="switch-field">
                  <input type="radio" name="pagination" id="pagination_on" value="1" {% if pagination == 1 %} checked="checked" {% endif %}/>
                  <label for="pagination_on">{{ text_enabled }}</label>
                  <input type="radio" name="pagination" id="pagination_off" value="0" {% if pagination == 0 %} checked="checked" {% endif %}/>
                  <label for="pagination_off">{{ text_disabled }}</label>
                </div>
              </div>
            </div>

            {# Autoplay #}
            <div class="form-group">
              <label class="control-label" for="input-auto">{{ entry_auto }}</label>
              <div class="control-group">
                <div class="switch-field">
                  <input type="radio" name="auto" id="auto_on" value="1" {% if auto == 1 %} checked="checked" {% endif %}/>
                  <label for="auto_on">{{ text_enabled }}</label>
                  <input type="radio" name="auto" id="auto_off" value="0" {% if auto == 0 %} checked="checked" {% endif %}/>
                  <label for="auto_off">{{ text_disabled }}</label>
                </div>
              </div>
            </div>

            {# Speed #}
            <div class="form-group">
              <label class="control-label" for="input-speed">{{ entry_speed }}</label>
              <div class="control-group">
                <input type="text" name="speed" value="{{ speed }}" placeholder="{{ entry_speed }}" id="input-speed" class="form-control" />
              </div>
            </div>

          {# Allow comment #}
          <div class="form-group">
            <label class="control-label" for="input-comments"><span data-toggle="tooltip" title="{{ help_allow_comments }}">{{ entry_allow_comments }}</span></label>
            <div class="control-group">
              <div class="switch-field">
                <input type="radio" name="comments" id="comments_on" value="1" {% if comments == 1 %} checked="checked" {% endif %}/>
                <label for="comments_on">{{ text_yes }}</label>
                <input type="radio" name="comments" id="comments_off" value="0" {% if not comments %} checked="checked" {% endif %}/>
                <label for="comments_off">{{ text_no }}</label>
              </div>
            </div>
          </div>

          {# Login Required #}
          <div class="form-group">
            <label class="control-label" for="input-login"><span data-toggle="tooltip" title="{{ help_login_required }}">{{ entry_login_required }}</span></label>
            <div class="control-group">
              <div class="switch-field">
                <input type="radio" name="login" id="login_on" value="1" {% if login == 1 %} checked="checked" {% endif %}/>
                <label for="login_on">{{ text_yes }}</label>
                <input type="radio" name="login" id="login_off" value="0" {% if not login %} checked="checked" {% endif %}/>
                <label for="login_off">{{ text_no }}</label>
              </div>
            </div>
          </div>

          {# Auto Approve #}
          <div class="form-group">
            <label class="control-label" for="input-auto_approve"><span data-toggle="tooltip" title="{{ help_auto_approve }}">{{ entry_auto_approve }}</span></label>
            <div class="control-group">
              <div class="switch-field">
                <input type="radio" name="auto_approve" id="auto_approve_on" value="1" {% if auto_approve == 1 %} checked="checked" {% endif %}/>
                <label for="auto_approve_on">{{ text_yes }}</label>
                <input type="radio" name="auto_approve" id="auto_approve_off" value="0" {% if not auto_approve %} checked="checked" {% endif %}/>
                <label for="auto_approve_off">{{ text_no }}</label>
              </div>
            </div>
          </div>

          {# Blog List #}
          <table class="table table-striped table-bordered table-hover">
            <thead>
              <tr>
                <td class="text-left">{{ column_title }}</td>
                <td class="text-left">{{ column_status }}</td>
                <td class="text-right">{{ column_comments }}</td>
                <td class="text-right">{{ column_date_added }}</td>
                <td class="text-right">{{ column_action }}</td>
              </tr>
            </thead>
            {% if tdblog_entries %}
            <tbody>
              {% for entry in tdblog_entries %}
              <tr>
                <td class="text-left">{{ entry.title }}</td>
                <td class="text-left">{{ entry.status }}</td>
                <td class="text-right">{{ entry.total_comments }}</td>
                <td class="text-right">{{ entry.date_added }}</td>
                <td class="text-right">
                  <a onclick="confirm('{{ text_confirm }}') ? location.href='{{ entry.delete }}' : false;" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></a>
                  <a href="{{ entry.comments }}" data-toggle="tooltip" title="{{ button_comments }}" class="btn btn-info"><i class="fa fa-eye"></i></a>
                  <a href="{{ entry.edit }}" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary"><i class="fa fa-pencil"></i></a>
                  </td>
              </tr>
               {% endfor %}
            </tbody>
            {% endif %}
            {# Add Blog #}
            <tfoot>
            {% if add_blog %}
              <tr>
                <td class="text-right" colspan="5"><button type="button" onclick="location = '{{ add_blog }}';" data-toggle="tooltip" title="{{ button_add_blog }}" class="btn btn-primary"><i class="fa fa-plus-circle"></i></button></td>
              </tr>
               {% else %}
              <tr>
                <td class="text-center" colspan="5">{{ text_save_module }}</td>
              </tr>
              {% endif %}
            </tfoot>
          </table>
          <input type="hidden" name="saveandstay" id="saveandstay" value="0">
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}