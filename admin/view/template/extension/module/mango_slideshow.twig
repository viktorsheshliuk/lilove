{{ header }}{{ column_left }} 
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-slideshow" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %} 
        <li><a href="{{ breadcrumb['href'] }}">{{ breadcrumb['text'] }}</a></li>
        {% endfor %} 
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if (error_warning) %} 
    <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }} 
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %} 
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-slideshow" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-name">{{ entry_name }}</label>
            <div class="col-sm-4">
              <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control" />
              {% if (error_name) %} 
              <div class="text-danger">{{ error_name }}</div>
              {% endif %} 
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-width">{{ entry_width }}</label>
            <div class="col-sm-2">
              <input type="number" name="width" value="{{ width }}" placeholder="{{ entry_width }}" id="input-width" class="form-control" />
              {% if (error_width) %} 
              <div class="text-danger">{{ error_width }}</div>
              {% endif %} 
            </div>
            <label class="col-sm-1 control-label" for="input-height">{{ entry_height }}</label>
            <div class="col-sm-2">
              <input type="number" name="height" value="{{ height }}" placeholder="{{ entry_height }}" id="input-height" class="form-control" />
              {% if (error_height) %} 
              <div class="text-danger">{{ error_height }}</div>
              {% endif %} 
            </div>
            <p class="col-sm-5 text-info">{{ text_size_pc }}</p>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-width">{{ entry_width_mobile }}</label>
            <div class="col-sm-2">
              <input type="number" name="width_mobile" value="{{ width_mobile }}" placeholder="{{ entry_width_mobile }}" id="input-width" class="form-control" />
              {% if (error_width) %} 
              <div class="text-danger">{{ error_width }}</div>
              {% endif %} 
            </div>
            <label class="col-sm-1 control-label" for="input-height">{{ entry_height_mobile }}</label>
            <div class="col-sm-2">
              <input type="number" name="height_mobile" value="{{ height_mobile }}" placeholder="{{ entry_height_mobile }}" id="input-height" class="form-control" />
              {% if (error_height) %} 
              <div class="text-danger">{{ error_height }}</div>
              {% endif %} 
            </div>
            <p class="col-sm-5 text-info">{{ text_size_mobile }}</p>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-css-class">{{ entry_css_class }}</label>
            <div class="col-sm-4">
              <input type="text" name="css_class" value="{{ css_class }}" placeholder="{{ entry_css_class }}" id="input-css-class" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-4">
              <select name="status" id="input-status" class="form-control">
                {% if (status) %} 
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %} 
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %} 
              </select>
            </div>
          </div>
          <ul class="nav nav-tabs" id="language">
            {% for language in languages %} 
            <li><a href="#language{{ language['language_id'] }}" data-toggle="tab"><img src="language/{{ language['code'] }}/{{ language['code'] }}.png" title="{{ language['name'] }}" /> {{ language['name'] }}</a></li>
            {% endfor %} 
          </ul>
           <div class="tab-content">
            {% set image_row = 0 %} 
            {% for language in languages %} 
            <div class="tab-pane" id="language{{ language['language_id'] }}">
              <table id="images{{ language['language_id'] }}" class="table table-striped table-bordered table-hover">
                <thead>
                  <tr>
                    {# <td class="text-left" style="width: 55%;">{{ entry_title }}</td> #}
                    <td class="text-left" style="width: 35%;">{{ entry_link }}</td>
                    <td class="text-center" style="width: 25%;">{{ entry_image }}</td>
                    <td class="text-center" style="width: 25%;">{{ entry_image_mobile }}</td>
                    <td class="text-right" style="width: 10%;">{{ entry_sort_order }}</td>
                    <td></td>
                  </tr>
                </thead>
                <tbody>
                {% if (slideshow_images[language['language_id']] is defined) %} 
                {% for slideshow_image in slideshow_images[language['language_id']] %} 
                  <tr id="image-row{{ image_row }}">
 {#                    <td class="text-left">
                     <div class="form-group">
                       <div class="col-sm-9">  
                         <input type="text" name="slideshow_image[{{ language['language_id'] }}][{{ image_row }}][text_1]" value="{{ slideshow_image['text_1'] }}" placeholder="{{ entry_text_1 }}" class="form-control" />
                       </div>
                       <div class="col-sm-3">  
                         <div class="input-group colorpicker-component"> 
                           <input type="text" name="slideshow_image[{{ language['language_id'] }}][{{ image_row }}][text_1_color]" value="{{ slideshow_image['text_1_color'] }}" class="form-control" />  
                           <span class="input-group-addon"><i style="background-color: #ffffff;"></i></span>
                         </div>
                       </div>  
                     </div>
                     <div class="form-group">
                       <div class="col-sm-9">  
                         <input type="text" name="slideshow_image[{{ language['language_id'] }}][{{ image_row }}][text_2]" value="{{ slideshow_image['text_2'] }}" placeholder="{{ entry_text_2 }}" class="form-control" />
                       </div>
                       <div class="col-sm-3">  
                         <div class="input-group colorpicker-component"> 
                           <input type="text" name="slideshow_image[{{ language['language_id'] }}][{{ image_row }}][text_2_color]" value="{{ slideshow_image['text_2_color'] }}" class="form-control" />  
                           <span class="input-group-addon"><i style="background-color: #ffffff;"></i></span>
                         </div>
                       </div>  
                     </div>
                     <div class="form-group">
                       <div class="col-sm-9">  
                         <input type="text" name="slideshow_image[{{ language['language_id'] }}][{{ image_row }}][button_text]" value="{{ slideshow_image['button_text'] }}" placeholder="{{ entry_button_text }}" class="form-control" />
                       </div> 
                       <div class="col-sm-3">
                         <select name="slideshow_image[{{ language['language_id'] }}][{{ image_row }}][button_style]" class="form-control">
                           <option value="1" {{ slideshow_image['button_style'] == 1 ? 'selected' : '' }}>{{ text_button_style }} 1</option>
                           <option value="2" {{ slideshow_image['button_style'] == 2 ? 'selected' : '' }}>{{ text_button_style }} 2</option>
                           <option value="3" {{ slideshow_image['button_style'] == 3 ? 'selected' : '' }}>{{ text_button_style }} 3</option>
                         </select>
                       </div>
                     </div>
                     <div class="form-group">
                       <label class="col-sm-4 control-label">{{ entry_text_align }}</label>
                       <div class="col-sm-8">
                         <select name="slideshow_image[{{ language['language_id'] }}][{{ image_row }}][align]" class="form-control">
                           <option value="center" {{ slideshow_image['align'] == 'center' ? 'selected' : '' }}>{{ text_center }}</option>
                           <option value="left" {{ slideshow_image['align'] == 'left' ? 'selected' : '' }}>{{ text_left }}</option>
                           <option value="right" {{ slideshow_image['align'] == 'right' ? 'selected' : '' }}>{{ text_right }}</option>
                         </select>
                       </div>
                     </div>
                    </td>	 #}
                    <td class="text-left">
                      <input type="text" name="slideshow_image[{{ language['language_id'] }}][{{ image_row }}][link]" value="{{ slideshow_image['link'] }}" placeholder="{{ entry_link }}" class="form-control" />
                    </td>
                    <td class="text-center">
                      <a href="" id="thumb-image{{ image_row }}" data-toggle="image" class="img-thumbnail">
                        <img src="{{ slideshow_image['thumb'] }}" alt="" title="" data-placeholder="{{ placeholder }}" />
                      </a>
                      <input type="hidden" name="slideshow_image[{{ language['language_id'] }}][{{ image_row }}][image]" value="{{ slideshow_image['image'] }}" id="input-image{{ image_row }}" />
                    </td>
                    <td class="text-center">
                      <a href="" id="thumb-image-mobile{{ image_row }}" data-toggle="image" class="img-thumbnail">
                        <img src="{{ slideshow_image['thumb-mobile'] }}" alt="" title="" data-placeholder="{{ placeholder }}" />
                      </a>
                      <input type="hidden" name="slideshow_image[{{ language['language_id'] }}][{{ image_row }}][image-mobile]" value="{{ slideshow_image['image-mobile'] }}" id="input-image-mobile{{ image_row }}" />
                    </td>
                    <td class="text-right">
                      <input type="text" name="slideshow_image[{{ language['language_id'] }}][{{ image_row }}][sort_order]" value="{{ slideshow_image['sort_order'] }}" placeholder="{{ entry_sort_order }}" class="form-control" />
                    </td>
                    <td class="text-left">
                      <button type="button" onclick="$('#image-row{{ image_row }}, .tooltip').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button>
                    </td>
                  </tr>
                {% set image_row = image_row + 1 %} 
                {% endfor %} 
                {% endif %} 
                </tbody>
                <tfoot>
                  <tr>
                    <td colspan="4"></td>
                    <td class="text-left"><button type="button" onclick="addImage('{{ language['language_id'] }}');" data-toggle="tooltip" title="{{ button_slideshow_add }}" class="btn btn-primary"><i class="fa fa-plus-circle"></i></button></td>
                  </tr>
                </tfoot>
              </table>
           </div>
            {% endfor %} 
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
