{{ header }}{{ column_left }} 
<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <div class="pull-right">
                <button type="submit" form="form-pre_payment" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
                <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
            <h1>{{ heading_title }}</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %} 
                <li><a href="{{ breadcrumb['href'] }}">{{ breadcrumb['text'] }}</a></li>
                {% endfor %} 
            </ul>
        </div>
    </div>
    <div class="container-fluid">
        {% if (error_warning) %} 
        <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }} 
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
        {% endif %} 
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
            </div>
            <div class="panel-body">
                <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-pre_payment">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
                            <div class="col-sm-10">
                                <select name="total_pre_payment_status" id="input-status" class="form-control">
                                    {% if (total_pre_payment_status) %} 
                                    <option value="1" selected="selected">{{ text_enabled }}</option>
                                    <option value="0">{{ text_disabled }}</option>
                                    {% else %} 
                                    <option value="1">{{ text_enabled }}</option>
                                    <option value="0" selected="selected">{{ text_disabled }}</option>
                                    {% endif %} 
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-2 control-label" for="input-sort-order">{{ entry_sort_order }}</label>
                            <div class="col-sm-10">
                                <input type="text" name="total_pre_payment_sort_order" value="{{ total_pre_payment_sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control" />
                            </div>
                        </div>
                    </div>
                    <section id='setting' class='table vat'>
                        <table class='table table-bordered'>
                            <tr class="row">
                                <td class='form-group col-sm-4'>
                                    <h3>{{ text_summ }}</h3>
                                    <div class="alert alert-info" role="alert"><i class="fa fa-question-circle" aria-hidden="true"></i> {{ text_summ_help }}</div>
                                    <div class="form-inline">
                                        <div class="form-group">
                                            <label for="from_sum">{{ entry_from_summ }}</label>
                                            <input type="number" min='0'  name='total_pre_payment_from_summ' value="{{ total_pre_payment_from_summ }}" class="form-control medium-input" id="from_sum">
                                        </div>
                                        <div class="form-group">
                                            <label for="to_sum">{{ entry_to_summ }}</label>
                                            <input type="number" min='0'  name='total_pre_payment_to_summ' value="{{ total_pre_payment_to_summ }}" class="form-control medium-input" id="to_sum">
                                        </div>
                                    </div>
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="col-sm-2 control-label" for="input-status">{{ entry_description }}</label>
                                            <div class="col-sm-10">
                                                <textarea name='total_pre_payment_descr' class='form-control'>{{ total_pre_payment_descr }}</textarea>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class='form-group col-sm-8'>
                                    <h3>{{ text_calc_method }}</h3>
                                    <div class="alert alert-info" role="alert"><i class="fa fa-question-circle" aria-hidden="true"></i> {{ text_calc_method_help }}</div>
                                    <div class='form-group'>
                                        <input type='radio' {% if (total_pre_payment_calc_method == 'fixed') %} checked {% endif %} name='total_pre_payment_calc_method' value='fixed'> {{ entry_calc_method_fixed }} 
                                            <input type='number' value='{{ total_pre_payment_fixed_val }}' min='0'  class='form-control small-input' name='total_pre_payment_fixed_val'><br>
                                        <input type='radio' {% if (total_pre_payment_calc_method == 'custom_formule') %} checked {% endif %} name='total_pre_payment_calc_method' value='custom_formule'> {{ entry_calc_method_custom }}
                                    </div>
                                    <div class='form-group'>
                                        <table class='table table-bordered vam text-center'>
                                            <tr>
                                                <td>
                                                    <input type='number' min='0' max='100'  name='total_pre_payment_shipping_prec' value='{{ total_pre_payment_shipping_prec }}' class='form-control small-input'>%<br>
                                                    {{ entry_shipping_prec }}
                                                </td>
                                                <td>+</td>
                                                <td>
                                                    <input type='number' min='0' max='100'  name='total_pre_payment_coupon_prec' value='{{ total_pre_payment_coupon_prec }}' class='form-control small-input'>%<br>
                                                    {{ entry_coupon_prec }}
                                                </td>
                                                <td>+</td>
                                                <td>
                                                    <input type='number' min='0' max='100'  name='total_pre_payment_subtotal_prec' value='{{ total_pre_payment_subtotal_prec }}' class='form-control small-input'>%<br>
                                                    {{ entry_subtotal_prec }}
                                                </td>
                                                <td>+</td>
                                                <td>
                                                    <input type='number' min='0' max='100'  name='total_pre_payment_reward_prec' value='{{ total_pre_payment_reward_prec }}' class='form-control small-input'>%<br>
                                                    {{ entry_reward_prec }}
                                                </td>
                                                <td>+</td>
                                                <td>
                                                    <input type='number' min='0' max='100'  name='total_pre_payment_total_prec' value='{{ total_pre_payment_total_prec }}' class='form-control small-input'>%<br>
                                                    {{ entry_total_prec }}
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        </table>
                        <table class='table table-bordered descr_check'>
                            <tr>
                                <td class='form-group'>
                                    <h3>{{ text_check_status }}</h3>
                                    <div class="alert alert-info" role="alert"><i class="fa fa-question-circle" aria-hidden="true"></i> {{ text_check_status_help }}</div>
                                    <div class="form-horizontal">
                                        <div class="form-group">
                                            <label class="col-sm-2 control-label" for="input-descr_check">{{ entry_description }}</label>
                                            <div class="col-sm-10">
                                                <textarea name='total_pre_payment_descr_check' class='form-control'>{{ total_pre_payment_descr_check }}</textarea>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </table>
                        <table class='table table-bordered'>
                            <tr class="row"> 
                                {#  Статуты заказов #}
                                <td class='form-group col-sm-4 stock_status'>
                                    <h3>{{ text_stock_status }}</h3>
                                    <div class="alert alert-info" role="alert"><i class="fa fa-question-circle" aria-hidden="true"></i> {{ text_stock_status_help }}</div>
                                    <div class="form-group">
                                        {% for ss in stock_status %} 
                                        <div class="checkbox">
                                            <label><input {% if ss["code"] in total_pre_payment_stock_status %} checked {% endif %} type='checkbox'  name='total_pre_payment_stock_status[]' value='{{ ss["code"] }}'> {{ ss["name"] }}</label>
                                        </div>
                                        {% endfor %} 
                                    </div>
                                </td>
                                {#  Статуты заказов #}
                                <td class='form-group col-sm-4'>
                                    <h3>{{ text_shipping_methods }}</h3>
                                    <div class="alert alert-info" role="alert"><i class="fa fa-question-circle" aria-hidden="true"></i> {{ text_shipping_methods_help }}</div>
                                    <div class="form-group">
                                        {% for sm in shipping_methods %} 
                                        <div class="checkbox">
                                            <label><input {% if sm["code"] in total_pre_payment_shipping_method %} checked {% endif %} type='checkbox'  name='total_pre_payment_shipping_method[]' value='{{ sm["code"] }}'> {{ sm["name"] }}</label>
                                        </div>
                                        {% endfor %} 
                                    </div>
                                </td>
                                <td class='form-group col-sm-4'>
                                    <h3>{{ text_payment_methods }}</h3>
                                    <div class="alert alert-info" role="alert"><i class="fa fa-question-circle" aria-hidden="true"></i> {{ text_payment_methods_help }}</div>
                                    <div class="form-group">
                                        {% for pm in payment_methods %} 
                                        <div class="checkbox">
                                            <label><input {% if pm["code"] in total_pre_payment_payment_method %} checked {% endif %} type='checkbox' name='total_pre_payment_payment_method[]' value='{{ pm["code"] }}'> {{ pm["name"] }}</label> 
                                        </div>
                                        {% endfor %} 
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </section>
                </form>
            </div>
        </div>
    </div>
</div>
</div>
<style>
    .small-input
    {
        width: 100px!important;
    }
    .medium-input
    {
        width: 100px!important;
    }
    .vat td
    {
        vertical-align: top!important;
    }
    .vam td
    {
        vertical-align: middle!important;
    }
    .form-control
    {
        display: inline-block;
    }
</style>
{{ footer }}