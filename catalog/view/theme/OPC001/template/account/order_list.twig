{{ header }}
<div class="tdbreadcrumb">
  <div class="breadcrumb container">
    <h1 class="breadcrumb-title">{{ heading_title }}</h1>
    <ol>
      {% for breadcrumb in breadcrumbs %}
      <li>
        <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
      </li>
      {% endfor %}
    </ol>
  </div>
</div>
<div id="account-order" class="container">
  <div class="row">{{ column_left }}
   {% if column_left and column_right %}
   {% set class = 'col-xs-12 col-sm-12 col-md-12 col-lg-6 col-xl-6' %}
   {% elseif column_left or column_right %}
   {% set class = 'col-xs-12 col-sm-12 col-md-12 col-lg-9 col-xl-9' %}
   {% else %}
   {% set class = 'col-xs-12 col-sm-12 col-md-12 col-lg-12 col-xl-12' %}
   {% endif %}
    <div id="content" class="page-content {{ class }}">{{ content_top }}
      <h2>{{ heading_title }}</h2>
      {% if orders %}
      <div class="table-responsive">
        <table class="table table-bordered">
          <thead>
            <tr>
              <td class="text-xs-right">{{ column_order_id }}</td>
              <td class="text-xs-left">{{ column_customer }}</td>
              <td class="text-xs-right">{{ column_product }}</td>
              <td class="text-xs-left">{{ column_status }}</td>
              <td class="text-xs-right">{{ column_total }}</td>
              <td class="text-xs-left">{{ column_date_added }}</td>
              <td></td>
            </tr>
          </thead>
          <tbody>
           {% for order in orders %}
            <tr>
              <td class="text-xs-right">#{{ order.order_id }}</td>
              <td class="text-xs-left">{{ order.name }}</td>
              <td class="text-xs-right">{{ order.products }}</td>
              <td class="text-xs-left">{{ order.status }}</td>
              <td class="text-xs-right">{{ order.total }}</td>
              <td class="text-xs-left">{{ order.date_added }}</td>
              <td class="text-xs-right"><a href="{{ order.view }}" data-toggle="tooltip" title="{{ button_view }}" class="btn btn-primary"><i class="fa fa-eye"></i></a></td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <div class="pagination-result">
        <div class="results">{{ results }}</div>
        <div class="pagination_bottom">{{ pagination }}</div>
      </div>
      {% else %}
      <p>{{ text_empty }}</p>
      {% endif %}
      <div class="buttons clearfix">
        <div class="pull-right"><a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a></div>
      </div>
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{{ footer }}
