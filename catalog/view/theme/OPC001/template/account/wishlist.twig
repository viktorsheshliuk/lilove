{{ header }}
<div class="tdbreadcrumb">
  <div class="breadcrumb container">
    <h1 class="breadcrumb-title">{{ heading_title }}</h1>
    <ol>
      {% for breadcrumb in breadcrumbs %}
      <li>
        <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
      </li>
      {% endfor %}
    </ol>
  </div>
</div>
<div id="account-wishlist" class="container">
  {% if success %}
  <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
    <button type="button" class="close" data-dismiss="alert">&times;</button>
  </div>
  {% endif %}
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-xs-12 col-sm-12 col-md-12 col-lg-6 col-xl-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-xs-12 col-sm-12 col-md-12 col-lg-9 col-xl-9' %}
    {% else %}
    {% set class = 'col-xs-12 col-sm-12 col-md-12 col-lg-12 col-xl-12' %}
    {% endif %}
    <div id="content" class="page-content {{ class }}">{{ content_top }}
      <h2>{{ heading_title }}</h2>
      {% if products %}
      <div class="table-responsive">
        <table class="table table-bordered">
          <thead>
            <tr>
              <td class="text-xs-center">{{ column_image }}</td>
              <td class="text-xs-left">{{ column_name }}</td>
              <td class="text-xs-left">{{ column_model }}</td>
              <td class="text-xs-right">{{ column_stock }}</td>
              <td class="text-xs-right">{{ column_price }}</td>
              <td class="text-xs-right">{{ column_action }}</td>
            </tr>
          </thead>
          <tbody>
            {% for product in products %}
            <tr>
              <td class="text-xs-center">{% if product.thumb %}<a href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" /></a>{% endif %}</td>
              <td class="text-xs-left"><a href="{{ product.href }}">{{ product.name }}</a></td>
              <td class="text-xs-left">{{ product.model }}</td>
              <td class="text-xs-right">{{ product.stock }}</td>
              <td class="text-xs-right">{% if product.price %}
                <div class="price"> {% if not product.special %}
                  {{ product.price }}
                  {% else %} <b>{{ product.special }}</b> <s>{{ product.price }}</s> {% endif %} </div>
                {% endif %}</td>
                <td class="text-xs-right wlbtn"><button type="button" onclick="cart.add('{{ product.product_id }}');" data-toggle="tooltip" title="{{ button_cart }}" class="wishlistcart btn btn-primary"><i class="fa fa-shopping-cart"></i></button>
                  <a href="{{ product.remove }}" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-secondary"><i class="fa fa-trash-o"></i></a></td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          {% else %}
          <p>{{ text_empty }}</p>
          {% endif %}
          <div class="buttons clearfix">
            <div class="pull-right"><a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a></div>
          </div>
        {{ content_bottom }}</div>
      {{ column_right }}</div>
    </div>
    {{ footer }}