{{ header }}
<div class="tdbreadcrumb">
  <div class="breadcrumb container">
    <h1 class="breadcrumb-title">{{ heading_title }}</h1>
    <ol>
      {% for breadcrumb in breadcrumbs %}
      <li>
        <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
      </li>
      {% endfor %}
    </ol>
  </div>
</div>
<div id="account-reward" class="container">
  <div class="row">{{ column_left }}
   {% if column_left and column_right %}
   {% set class = 'col-xs-12 col-sm-12 col-md-12 col-lg-6 col-xl-6' %}
   {% elseif column_left or column_right %}
   {% set class = 'col-xs-12 col-sm-12 col-md-12 col-lg-9 col-xl-9' %}
   {% else %}
   {% set class = 'col-xs-12 col-sm-12 col-md-12 col-lg-12 col-xl-12' %}
   {% endif %}
    <div id="content" class="page-content {{ class }}">{{ content_top }}
      <h2>{{ heading_title }}</h2>
      <p>{{ text_total }} <b>{{ total }}</b>.</p>
      <div class="table-responsive">
        <table class="table table-bordered">
          <thead>
            <tr>
              <td class="text-xs-left">{{ column_date_added }}</td>
              <td class="text-xs-left">{{ column_description }}</td>
              <td class="text-xs-right">{{ column_points }}</td>
            </tr>
          </thead>
          <tbody>
          {% if rewards %}
          {% for reward in rewards %}
          <tr>
            <td class="text-xs-left">{{ reward.date_added }}</td>
            <td class="text-xs-left">{% if reward.order_id %} <a href="{{ reward.href }}">{{ reward.description }}</a> {% else %}
              {{ reward.description }}
              {% endif %}</td>
            <td class="text-xs-right">{{ reward.points }}</td>
          </tr>
          {% endfor %}
          {% else %}
          <tr>
            <td class="text-center" colspan="3">{{ text_empty }}</td>
          </tr>
          {% endif %}
            </tbody>
        </table>
      </div>
      <div class="pagination-result">
        <div class="results">{{ results }}</div>
        <div class="pagination_bottom">{{ pagination }}</div>
      </div>
      <div class="buttons clearfix">
        <div class="pull-right"><a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a></div>
      </div>
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{{ footer }}