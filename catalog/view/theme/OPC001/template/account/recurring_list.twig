{{ header }}
<div class="tdbreadcrumb">
  <div class="breadcrumb container">
    <h1 class="breadcrumb-title">{{ heading_title }}</h1>
    <ol>
      {% for breadcrumb in breadcrumbs %}
      <li>
        <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
      </li>
      {% endfor %}
    </ol>
  </div>
</div>
<div id="account-recurring" class="container">
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-xs-12 col-sm-12 col-md-12 col-lg-6 col-xl-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-xs-12 col-sm-12 col-md-12 col-lg-9 col-xl-9' %}
    {% else %}
    {% set class = 'col-xs-12 col-sm-12 col-md-12 col-lg-12 col-xl-12' %}
    {% endif %}
    <div id="content" class="page-content {{ class }}">{{ content_top }}
      <h2>{{ heading_title }}</h2>
      {% if recurrings %}
      <div class="table-responsive">
        <table class="table table-bordered">
          <thead>
            <tr>
              <td class="text-xs-right">{{ column_order_recurring_id }}</td>
              <td class="text-xs-left">{{ column_product }}</td>
              <td class="text-xs-left">{{ column_status }}</td>
              <td class="text-xs-left">{{ column_date_added }}</td>
              <td class="text-xs-right"></td>
            </tr>
          </thead>
          <tbody>

          {% for recurring in recurrings %}
          <tr>
            <td class="text-xs-right">#{{ recurring.order_recurring_id }}</td>
            <td class="text-xs-left">{{ recurring.product }}</td>
            <td class="text-xs-left">{{ recurring.status }}</td>
            <td class="text-xs-left">{{ recurring.date_added }}</td>
            <td class="text-xs-right"><a href="{{ recurring.view }}" data-toggle="tooltip" title="{{ button_view }}" class="btn btn-secondary"><i class="fa fa-eye"></i></a></td>
          </tr>
          {% endfor %}

          </tbody>
        </table>
      </div>
      <div class="pagination-result">
        <div class="results">{{ results }}</div>
        <div class="pagination_bottom">{{ pagination }}</div>
      </div>
      {% else %}
      <p>{{ text_empty }}</p>
      {% endif %}
      <div class="buttons clearfix">
        <div class="pull-right"><a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a></div>
      </div>
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{{ footer }}