{{ header }}


<div class="tdbreadcrumb" xmlns:v="http://rdf.data-vocabulary.org/#">
  <div class="breadcrumb container">
    <h1 class="breadcrumb-title">{{ heading_title }}</h1>
    <ol>
      {% for breadcrumb in breadcrumbs %}
      <li>
	    <span typeof="v:Breadcrumb">
			<a href="{{ breadcrumb.href }}" rel="v:url" property="v:title">{{ breadcrumb.text }}</a>
		</span>
      </li>
      {% endfor %}
    </ol>
  </div>
</div>


<div id="product-category" class="container">
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-xs-12 col-sm-12 col-md-12 col-lg-6 col-xl-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-xs-12 col-sm-12 col-md-12 col-lg-9 col-xl-9' %}
    {% else %}
    {% set class = 'col-xs-12 col-sm-12 col-md-12 col-lg-12 col-xl-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      {% if thumb or description %}
        {% if thumb %}
          <div class="categories-thumb">
            <img src="{{ thumb }}" alt="{{ heading_title }}" title="{{ heading_title }}" class="img-responsive" />
          </div>
        {% endif %}
         <span>{{ heading_title }}</span>
        
        <hr>
      {% endif %}
      {% if categories %}
      <span>{{ text_refine }}</span>
      {% if categories|length <= 5 %}
      <div class="row">
        <div class="col-sm-3 col-xs-6">
          <ul>
            {% for category in categories %}
            <li><a href="{{ category.href }}">{{ category.name }}</a></li>
            {% endfor %}
          </ul>
        </div>
      </div>
      {% else %}
      <div class="row">{% for category in categories|batch((categories|length / 4)|round(1, 'ceil')) %}
        <div class="col-sm-3 col-xs-6">
          <ul>
            {% for child in category %}
            <li><a href="{{ child.href }}">{{ child.name }}</a></li>
            {% endfor %}
          </ul>
        </div>
        {% endfor %}</div>
      <br />
      {% endif %}
      {% endif %}
      {% if products %}
        {% include themedir ~ '/template/product/layout/categoryinfo.twig' %}
      {% endif %}
      {% if not categories and not products %}
      <p>{{ text_empty }}</p>
      <div class="buttons">
        <div class="pull-right"><a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a></div>
      </div>
      {% endif %}
      {{ content_bottom }}
    </div>
	{% if description %}
          <div class="categories-desc">{{ description }}</div>
        {% endif %}
    {{ column_right }}
  </div>
</div>
{{ footer }}
