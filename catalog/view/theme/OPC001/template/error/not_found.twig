{{ header }}
<div class="tdbreadcrumb">
  <div class="breadcrumb container">
    <h1 class="breadcrumb-title">{{ heading_title }}</h1>
    <ol>
      {% for breadcrumb in breadcrumbs %}
      <li>
        <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
      </li>
      {% endfor %}
    </ol>
  </div>
</div>
<div id="error-not-found" class="container">
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-xs-12 col-sm-12 col-md-12 col-lg-6 col-xl-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-xs-12 col-sm-12 col-md-12 col-lg-9 col-xl-9' %}
    {% else %}
    {% set class = 'col-xs-12 col-sm-12 col-md-12 col-lg-12 col-xl-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
    <!--  <span style="font-size: 1.375rem;" class="information">{{ heading_title }}</span> -->

	  
	  <div style="text-align: center; position: relative; height: 220px;  width: 320px; margin: 0 auto;">
		<div style="font-size: 180pt;font-weight: bold; color: #653724; position: absolute; top: 85px; left: -60px;">404</div>
	  </div>
	  
	  	<span style="text-align:center; display:block; color: #0681b4;  font-size: 52px; text-transform:uppercase;margin: 15px 0; ">Страница не найдена</span>
	  
	  <ul class="my-style-3">
		<h4 class="my-style-4">Ошибка могла произойти по нескольким причинам:</h4>
		<li>Скорее всего URL был вписан с ошибкой</li>
		<li>Страница, которую вы ищите, была перенесена или переименована</li>
		<li>Такой страницы больше не существует</li>
	  </ul>
	  
	  <p class="my-style-5">Пока проблема не решена вы можете <strong><a href="https://lilove.ua/">перейти на главную страницу</a></strong> сайта или на страницу <strong><a href="https://lilove.ua/katalog">каталога.</a></strong></p>
	  
     <!-- <p>{{ text_error }}</p> -->
	  
     <!-- <div class="buttons clearfix">
        <div class="pull-right"><a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a></div>
      </div>
	  -->
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{{ footer }}
