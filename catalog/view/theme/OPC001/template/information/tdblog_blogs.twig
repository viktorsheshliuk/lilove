{{ header }}
<div class="tdbreadcrumb">
  <div class="breadcrumb container">
    <h1 class="breadcrumb-title">{{ heading_title }}</h1>
    <ol>
      {% for breadcrumb in breadcrumbs %}
      <li>
        <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
      </li>
      {% endfor %}
    </ol>
  </div>
</div>
<div class="container">
  <div class="row">
    {{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-xs-12 col-sm-12 col-md-12 col-lg-6 col-xl-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-xs-12 col-sm-12 col-md-12 col-lg-9 col-xl-9' %}
    {% else %}
    {% set class = 'col-xs-12 col-sm-12 col-md-12 col-lg-12 col-xl-12' %}
    {% endif %}
    <div id="content" class="{{ class }} all-blog">
      {{ content_top }}
      {% if blogs %}
        {% for blog in blogs %}
        <div class="smartblogcat">
          {% if blog.blog_data %}
          {% for topic in blog.blog_data %}
          <div class="sdsarticleCat clearfix">
            <div class="articleContent">
              {% if topic.image %}
              <div class="blog-image">
                <img src="{{ topic.image }}" alt="{{ heading_title }}" title="{{ heading_title }}" class="imageFeatured" />
              </div>
              {% endif %}
              <div class="sdsarticleHeader">
                <div class="title_block">
                  <a href="{{ topic.href }}">{{ topic.title }}</a>
                </div>
                <span class="blogdetail">
                  <span class="blog-date"><i class="fa fa-calendar"></i> {{ topic.date_added }}</span>
                  <span class="write-comment-count">{{ topic.total_comments }} {{ entry_comment }}</span>
                </span>
                <div class="sdsarticle-des">
                  {{ topic.description }}
                </div>
                <div class="sdsreadMore">
                  <a class="r_more btn btn-primary" href="{{ topic.href }}">{{ text_read_more }}</a>
                </div>
              </div>
            </div>
          </div>
          {% endfor %}
          {% else %}
          <div class="panel-body text-center">{{ text_no_blogs }}</div>
          {% endif %}
        </div>
        {% endfor %}
     {% else %}
        <div class="panel-body text-center">{{ text_no_blogs }}</div>
    {% endif %}
  {{ content_bottom }}
  </div>
  {{ column_right }}
  </div>
</div>
{{ footer }}