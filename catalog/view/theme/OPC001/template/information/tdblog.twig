{{ header }}
<div class="tdbreadcrumb">
  <div class="breadcrumb container">
    <span style="display:block" class="breadcrumb-title">{{ heading_title }}</span>
    <ol>
      {% for breadcrumb in breadcrumbs %}
      <li>
        <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
      </li>
      {% endfor %}
    </ol>
  </div>
</div>
<div class="container">
  <div class="row">
    {{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-xs-12 col-sm-12 col-md-12 col-lg-6 col-xl-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-xs-12 col-sm-12 col-md-12 col-lg-9 col-xl-9' %}
    {% else %}
    {% set class = 'col-xs-12 col-sm-12 col-md-12 col-lg-12 col-xl-12' %}
    {% endif %}
    <div id="content" class="{{ class }} single-blog">{{ content_top }}
      <div class="blog-post-article">
        <div class="articleContent">
          {% if blogs.image %}
            <div class="blog-img">
              <img src="{{ blogs.image }}" alt="{{ heading_title }}" title="{{ heading_title }}" class="imageFeatured" />
            </div>
          {% endif %}
        </div>
        <div class="sdsarticleHeader">
          <div class="title_block">{{ heading_title }}</div>
          <span class="blogdetail">
            <span class="blog-date"><i class="fa fa-calendar"></i> {{ date }}</span>
          </span>
          <div class="blog-desc"> {{ description }} </div>
        </div>
      </div>
      {% if success %}
      <div class="alert alert-success"><i class="fa fa-check-circle"></i>
        {{ success }}
        <button type="button" class="close" data-dismiss="alert">&times;</button>
      </div>
      {% endif %}
      {% if blog_comments %}
        <div class="articleComments">
          <h3 class="commenttitle">{{ text_your_comments }}</h3>
          <div class="comments">
            {% for blog_comment in blog_comments %}
            <div class="view-comment">
              <div class="user-info-wrapper">
                <div class="user_icon"><i class="fa fa-user-circle"></i>
                  <div class="name">{{ blog_comment.author }}</div>
                  <div class="date">{{ blog_comment.date_added }}</div>
                </div>
                <div class="comment_info">
                  <div class="comment-text">{{ blog_comment.comment }}</div>
                </div>
              </div>
            </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}
      {% if allow_comments %}
        <div class="smartblogcomments">
          <h4 class="block-title">{{ button_comment_add }}</h4>
          <div id="add-comment">
            <div class="row">
              {% if login_required  and not is_logged %}
              <h4 class="text-center">{{ text_login_required }}</h4>
              {% else %}
              <form action="{{ action }}" method="post" enctype="multipart/form-data" class="form-horizontal">
                <div class="form-group required col-xs-12 col-sm-12 col-md-6">
                  <label class="control-label" for="input-author">{{ entry_author }}</label>
                  <input type="text" name="author" value="{{ author }}" id="input-author" placeholder="{{ entry_author }}" class="form-control" />
                  {% if error_author %}
                  <div class="text-danger">{{ error_author }}</div>
                  {% endif %}
                </div>
                <div class="form-group required col-xs-12 col-sm-12 col-md-6">
                  <label class="control-label" for="input-email">{{ entry_email }}</label>
                  <input type="text" name="email" value="{{ email }}" id="input-email" placeholder="{{ entry_email }}" class="form-control" />
                  {% if error_email %}
                  <div class="text-danger">{{ error_email }}</div>
                  {% endif %}
                </div>
                <div class="form-group col-xs-12">
                  <label class="control-label" for="input-comment">{{ entry_comment }}</label>
                  <textarea name="comment" rows="10" id="input-comment" class="form-control">{{ comment }}
                  </textarea>
                  {% if error_comment %}
                  <div class="text-danger">{{ error_comment }}</div>
                  {% endif %}
                </div>
                <div class="form-group col-xs-12">
                  {{ captcha }}
                </div>
                <div class="submit col-xs-12">
                  <input class="btn btn-primary" type="submit" value="{{ button_submit }}" title="{{ button_submit }}" />
                </div>
                <input type="hidden" name="auto_approve" value="{{ auto_approve }}" />
              </form>
              {% endif %}
            </div>
          </div>
        </div>
      {% endif %}
      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
</div>
{{ footer }}