<div id="tdbanner-{{ module }}" class="tdbanner hb-animate-element bottom-to-top clearfix">
	{% if items|length > 0 %}
		<div class="row">
			{% if config_module.type == 0 %}
				{% set classes = 'tdbannergrid' %}
				{% set bclasses = 'hb-animate-element bottom-to-top col-xs-12 col-md-4' %}
			{% elseif config_module.type == 1 %}
				{% set classes = ' tdbanner-carousel owl-carousel owl-theme ' %}
				{% set bclasses = 'col-xs-12' %}
			{% else %}
				{% set classes = '' %}
				{% set bclasses = '' %}
			{% endif %}
			<div id="banners-{{ module }}" class="{{ classes }}">
				{% if items %}
					{% set i = 1 %}
					{% for item in items %}
						<div class="tdbanners-container tdbanner-{{ i }} {{ bclasses }}">
							<div class="banner-main">
								<div class="tdbanner-images">
									<a class="tdbanners_inner" href="{{ item.url }}">
										{#<img data-src="image/{{ item.image }}" alt="{{ item.title }}">#}
										<img src="{{host}}image/{{ item.image }}" alt="{{ item.title }}">
										<span class="banner-data">
											<span class="inner-content">
												<span class="banner-title">{{ item.title }}</span>
												<span class="banner-subtitle">{{ item.subtitle }}</span>
											</span>
										</span>
									</a>
								</div>
							</div>
						</div>
						{% set i = i + 1 %}
					{% endfor %}
				{% endif %}
			</div>
		</div>
	{% else %}
		<p class="text_empty">{{ text_empty }}</p>
	{% endif %}
</div>
{% if config_module.type == 1 %}
<script type="text/javascript">
$(document).ready(function() {
	$("#banners-{{ module }}").owlCarousel({
		dots:false,
		autoplay: true,
		autoplayTimeout: 2000,
		autoplayHoverPause: true,
		nav: false,
		navElement: 'div',
		navText: ['<i class="fa icon"></i>', '<i class="fa icon"></i>'],
		rtl:($("html").attr('dir')=="rtl") ? true : false,
		rewind: true,
		responsive:{
			0:{
				items: 1
			},
			544:{
				items:1
			},
			768:{
				items:3
			},
			992:{
				items: 3
			},
			1200:{
				items: 3
			},
			1560:{
				items: 3
			}
		},
	});
});
</script>
{% endif %}