                            {% if product['recurring'] is not empty %}
                            - <small>{{ text_payment_profile }}: {{ product['profile_name'] }}</small>
                            {% endif %}
                            </div>
                            {% if product['reward'] %}
                            <small>{{ product['reward'] }}</small>
                            {% endif %}
                        </td>
                        <td class="model">{{ product['model'] }}</td>
                        <td class="quantity">
                            <div class="input-group btn-block" style="max-width: 200px;">
