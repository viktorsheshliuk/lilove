						<input type="text" name="quantity" value="1" class="oc-control" id="spiner_quantity" />
					<button onclick="$(this).prev().val(~~$(this).prev().val()-1);oc_update_price();" id="decrease_quantity">&mdash;</button>
				</div> 
						
				{% if price %}
					<div class="oc-price">
					
