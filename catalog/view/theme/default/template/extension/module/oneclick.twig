			</div>#}
		
			{# <div class="row"> #}
			<div class="inputs_box">
				{% if fields.firstname.status%}
				{# <div class="col-sm-6"> #}
				<div>
				<div class="oc-form-group oc-firstname{% if fields.firstname.required %} oc-required{% endif %}">
						{% if show_field_title %}<label for="control-firstname" class="control-label">{{ fields[lang_code]['firstname_title'] }}</label>{% endif %}
						<input type="text" name="firstname" value="" placeholder="{{ fields[lang_code]['firstname_placeholder'] }}" class="oc-control" id="control-firstname" />
				</div>
				</div>
				{% endif %}

				{% if fields.lastname.status %}
				<div class="col-sm-6">
				<div class="oc-form-group oc-lastname{% if fields.lastname.required%} oc-required{% endif %}">
						{% if show_field_title %}<label for="control-lastname" class="control-label">{{ fields[lang_code]['lastname_title'] }}</label>{% endif %}
						<input type="text" name="lastname" value="" placeholder="{{ fields[lang_code]['lastname_placeholder'] }}" class="oc-control" id="control-lastname" />
				</div>
				</div>
				{% endif %}

				{% if fields.email.status %}
				<div class="col-sm-6">
				<div class="oc-form-group oc-email{% if fields.email.required%} oc-required{% endif %}">
						{% if show_field_title %}<label for="control-email" class="control-label">{{ fields[lang_code]['email_title'] }}</label>{% endif %}
						<input type="text" name="email" value="" placeholder="{{ fields[lang_code]['email_placeholder'] }}" class="oc-control" id="control-email" />
				</div>
				</div>
				{% endif %}

				{% if fields.telephone.status %}
				{# <div class="col-sm-6"> #}
				<div>
				<div class="oc-form-group oc-telephone{% if fields.telephone.required%} oc-required{% endif %}">
						{% if show_field_title %}<label for="control-telephone" class="control-label">{{ fields[lang_code]['telephone_title'] }}</label>{% endif %}
						<input type="text" name="telephone" value="" placeholder="{{ fields[lang_code]['telephone_placeholder'] }}" class="oc-control phone-mask" id="control-telephone" />
				</div>
				</div>
				{% endif %}
			</div>

				{% if fields.address_1.status %}
				<div class="oc-form-group oc-address_1{% if fields.address_1.required%} oc-required{% endif %}">
						{% if show_field_title %}<label for="control-address_1" class="control-label">{{ fields[lang_code]['address_1_title'] }}</label>{% endif %}
						<input type="text" name="address_1" value="" placeholder="{{ fields[lang_code]['address_1_placeholder'] }}" class="oc-control" id="control-address_1" />
				</div>
				{% endif %}
				{% if fields.comment.status %}
				<div class="oc-form-group oc-comment{% if fields.comment.required%} oc-required{% endif %}">
						{% if show_field_title %}<label for="control-comment" class="control-label">{{ fields[lang_code]['comment_title'] }}</label>{% endif %}
						<textarea name="comment" placeholder="{{ fields[lang_code]['comment_placeholder'] }}" class="oc-control" rows="3" id="control-comment"></textarea>
				</div>
				{% endif %}

				<input type="hidden" name="product_id" value="{{ product_id }}" />
		</div>
		<div class="oc-footer">
			{% if (not stock_checkout  and  quantity > 0) or stock_checkout %}

				{% if agree%}
					<p><label><input type="checkbox" name="agree" value="1" /> {{ agree }}</label></p>
				{% endif %}

				<div class="row-buttons">
					{% if price %}
					<div class="oc-total">
							{{ total_title }}: 
							<span>
								{% if not special %}
										{{ price }}
									 {% else %}
										{{ special }}
								{% endif %}
							</span>
					</div>
					{% endif %}

					<button id="oc_submit" class="btn btn-success" onclick="oc_submit();">{{ order_button_text }}</button>

				</div>
				<div class="clearfix"></div>

			{% endif %}
		</div>
	</div>	
</div>
<script src="catalog/view/javascript/imask.js"></script>

<script>
document.querySelectorAll('.phone-mask') && document.querySelectorAll('.phone-mask').forEach(elem => IMask(elem, {
    mask: `+{38} (\\0code) 000-00-00`,
    lazy: false,
    placeholderChar: '_',
    blocks: {
      code: {
        mask: IMask.MaskedEnum,
        enum: [
          '44','50','63','65','66','67','68','69','73','93','94','95','96','97','98','99',
        ]
      }
    }
  }))
</script>