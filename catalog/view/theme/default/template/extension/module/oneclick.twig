<div class="oc">
	<div class="oneclick_wrapper">
		<div class="oc-head">
				{{ heading }}
				<div class="oc_head_label">{{ text_oc_head_label}}</div>
		</div>
		<div class="oc-body">			
				{% if show_images %}
				<div class="oc-images">
						<div class="oc-main-image">
								<img src="{{ thumb }}" alt="" />
						</div>
						{% if images %}
						<div class="oc-thumbs">
						{% for image in images %}
							<img src="{{ image.thumb }}" alt="" title="" onclick="oc_set_main_image('{{ image.popup }}', $(this)); return true;"{% if loop.index ==  1%} class="active"{% endif %} />
							{% if loop.index%1 ==  0 %}<br />{% endif %}
						{% endfor %}
						</div>
						{% endif %}
				</div>
		{% endif %}

		{% if product_options_allowed  and  show_options  and  options %}
			<div class="oc-options hidden">
				<h3 class="oc-options-title">{{ options_title }}</h3>
				{% for option in options %}
						
						{% if option.type  ==  'select' %}
							<div id="oc-option-{{ option.product_option_id }}" class="oc-option">
								<select onchange="oc_update();" name="option[{{ option.product_option_id }}]" class="oc-control">
									<option value="">{% if option.required  %}* {% endif %}{{ option.name }}</option>
									{% for option_value in option.product_option_value %}
										<option value="{{ option_value.product_option_value_id }}">{{ option_value.name }}
											{% if option_value.price  %}
												({{ option_value.price_prefix }}{{ option_value.price }})
											{% endif %}
										</option>
									{% endfor %}
								</select>
							</div>
						{% endif %}
						
						{% if option.type  ==  'text' %}
						<div id="oc-option-{{ option.product_option_id }}" class="oc-option">
							<label for="" class="oc-option-title">{% if option.required  %}* {% endif %}{{ option.name }}</label>
							<input type="text" name="option[{{ option.product_option_id }}]" value="{{ option.value }}" placeholder="{% if option.required  %}* {% endif %}}{{ option.name }}" class="oc-control" />
						</div>
						{% endif %}

						{% if option.type  ==  'textarea' %}
						<div id="oc-option-{{ option.product_option_id }}" class="oc-option">
							<label for="oc-option-{{ option.product_option_id }}" class="oc-option-title">{% if option.required  %}* {% endif %}}{{ option.name }}</label>
							<textarea name="option[{{ option.product_option_id }}]" placeholder="{% if option.required  %}* {% endif %}}{{ option.name }}" class="oc-control" id="oc-option-{{ option.product_option_id }}">{{ option.value }}</textarea>
						</div>
						{% endif %}

						{% if option.type  ==  'radio' %}
						<label class="oc-option-title">{% if option.required %}<span class="required">*</span>{% endif %}{{ option.name }}</label>
						<table id="oc-option-{{ option.product_option_id }}" class="oc-option">
							<tbody>
								{% for option_value in option.product_option_value %}
								<tr>
									<td class="input-td">
									<input onchange="oc_update();" type="radio" name="option[{{ option.product_option_id }}]" value="{{ option_value.product_option_value_id }}" id="oc-option-value-{{ option_value.product_option_value_id }}" />
									</td>
									<td>
										<label for="oc-option-value-{{ option_value.product_option_value_id }}">
											{{ option_value.name }}
										</label>
									</td>
									<td class="oc-text-right">
										{% if option_value.price  %}
											{{ option_value.price_prefix }}{{ option_value.price }}
										{% endif %}
									</td>
								</tr>
								{% endfor %}
							</tbody>
						</table>
						{% endif %}

						{% if option.type  ==  'checkbox' %}
						<label class="oc-option-title">{% if option.required  %}<span class="required">*</span>{% endif %}{{ option.name }}</label>
						<table id="oc-option-{{ option.product_option_id }}" class="oc-option">
							<tbody>
								{% for option_value in option.product_option_value %}
								<tr>
									<td class="input-td">
									<input
										onchange="oc_update();"
										type="checkbox"
										name="option[{{ option.product_option_id }}][]"
										value="{{ option_value.product_option_value_id }}"
										id="oc-option-value-{{ option_value.product_option_value_id }}"
									/>
									</td>
									<td>
										<label for="oc-option-value-{{ option_value.product_option_value_id }}">
											{{ option_value.name }}
										</label>
									</td>
									<td class="oc-text-right">
										{% if option_value.price  %}
											{{ option_value.price_prefix }}{{ option_value.price }}
										{% endif %}
									</td>
								</tr>
								{% endfor %}
							</tbody>
						</table>
						{% endif %}

						{% if option.type  ==  'image' %}
						<label class="oc-option-title">{% if option.required  %}<span class="required">*</span>{% endif %}{{ option.name }}</label>
						 <table id="oc-option-{{ option.product_option_id }}">
							<tbody>
								{% for option_value in option.product_option_value %}
								<tr>
									<td class="input-td">
									<input
										onchange="oc_update();"
										type="radio"
										name="option[{{ option.product_option_id }}]"
										value="{{ option_value.product_option_value_id }}"
										id="oc-option-value-{{ option_value.product_option_value_id }}"
									/>
									</td>
									<td style="width:{% if option_images_width  %}{{ option_images_width }}{% else %}{{ '50px' }}{% endif %};">
										<label for="oc-option-value-{{ option_value.product_option_value_id }}">
										<img src="{{ option_value.image }}" alt="{{ option_value.name ~ option_value.price }}" />
										</label>
									</td>
									<td>
										<label for="oc-option-value-{{ option_value.product_option_value_id }}" style="float: left;">
											{{ option_value.name }}
										</label>
									</td>
									<td>
										<label for="oc-option-value-{{ option_value.product_option_value_id }}" style="float: right;">
											{% if option_value.price  %}
												{{ option_value.price_prefix }}{{ option_value.price }}
											{% endif %}
										</label>
									</td>
								</tr>
								{% endfor %}
								
							</tbody>
						</table>
						{% endif %}

						{% if option.type  ==  'date' %}
							<label class="oc-option-title">{% if option.required  %}* {% endif %}{{ option.name }}</label>
							<div id="oc-option-{{ option.product_option_id }}" class="oc-option">
								<input
									type="text"
									name="option[{{ option.product_option_id }}]"
									value="{{ option.value }}"
									class="date_input oc-control"
									data-date-format="YYYY-MM-DD"
									placeholder="{% if option.required  %}* {% endif %}{{ option.name }}"
									onfocus="$(this).datetimepicker( { pickTime: false } );"
								/>
							</div>
						{% endif %}

						{% if option.type  ==  'datetime' %}
							<label class="oc-option-title">{% if option.required  %}* {% endif %}{{ option.name }}</label>
							<div id="oc-option-{{ option.product_option_id }}" class="oc-option">
								<input
									type="text"
									name="option[{{ option.product_option_id }}]"
									value="{{ option.value }}"
									class="datetime_input oc-control"
									data-date-format="YYYY-MM-DD HH:mm"
									placeholder="{% if option.required  %}* {% endif %}{{ option.name }}"
									onfocus="$(this).datetimepicker( { pickDate: true, pickTime: true } );"
								/>
							</div>
						{% endif %}

						{% if option.type  ==  'time' %}
							<label class="oc-option-title">{% if option.required  %}* {% endif %}}{{ option.name }}</label>
							<div id="oc-option-{{ option.product_option_id }}" class="oc-option">
								<input
									type="text"
									name="option[{{ option.product_option_id }}]"
									value="{{ option.value }}"
									class="time_input oc-control"
									data-date-format="HH:mm"
									placeholder="{% if option.required  %}* {% endif %}{{ option.name }}"
									onfocus="$(this).datetimepicker( { pickDate: false } );"
								/>
							</div>
						{% endif %}

				{% endfor %}
			</div>
		{% endif %}

