<div class="block-categories block top-categories hb-animate-element bottom-to-top">
  <span class="title_block"><b>{{heading_title}}</b></span>
  {% if categories %}
  <ul class="category-top-menu block_content">
    {% for category in categories %}
    {% if category.children %}
    <li class="category-item category-dropdown-menu">
      <a href="{{ category.href }}">{{ category.name }}</a>
      <span class="toggle-category"><i class="fa fa-angle-down"></i></span>
      {% for children in category.children|batch(category.children|length) %}
      <ul class="category-sub-menu">
        {% for child in children %}
        {% if child.children %}
        <li class="category-item category-dropdown-menu">
          <a href="{{ child.href }}">{{ child.name }}</a>
          <span class="toggle-category"><i class="fa fa-angle-down"></i></span>
          <ul class="category-sub-menu">
            {% for children in child.children %}
            <li class="category-item">
              <a href="{{ children.href }}">{{ children.name }}</a>
            </li>
            {% endfor %}
          </ul>
        </li>
        {% else %}
        <li class="category-item"><a href="{{ child.href }}">{{ child.name }}</a></li>
        {% endif %}
        {% endfor %}
      </ul>
      {% endfor %}
    </li>
    {% else %}
    <li><a href="{{ category.href }}">{{ category.name }}</a></li>
    {% endif %}
    {% endfor %}
  </ul>
  {% endif %}
</div>