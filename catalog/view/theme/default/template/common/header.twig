<html dir="{{ direction }}" lang="{{ lang }}">
<!--<![endif]-->
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>{{ title }}</title>
<base href="{{ base }}" />
{% if description %}
<meta name="description" content="{{ description }}" />
{% endif %}
{% if keywords %}
<meta name="keywords" content="{{ keywords }}" />
{% endif %}
<meta property="og:title" content="{{ title }}" />
{% if description %} <meta name="description" content="{{ description }}" /> <meta property="og:description" content="{{ description }}" /> {% endif %}
 <link href="{{ config_icon }}" rel="icon">  
<script src="catalog/view/javascript/jquery/jquery-2.1.1.min.js" type="text/javascript"></script>
<link href="catalog/view/javascript/bootstrap/css/bootstrap.min.css" rel="stylesheet" media="screen" />
<script src="catalog/view/javascript/bootstrap/js/bootstrap.min.js" type="text/javascript"></script>
<link href="catalog/view/javascript/font-awesome/css/font-awesome.min.css" rel="stylesheet" type="text/css" />
{# <link href="//fonts.googleapis.com/css?family=Open+Sans:400,400i,300,700" rel="stylesheet" type="text/css" /> #}
{# <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet"> #}
<link href="catalog/view/theme/default/stylesheet/stylesheet.css" rel="stylesheet">
{% for style in styles %}
<link href="{{ style.href }}" type="text/css" rel="{{ style.rel }}" media="{{ style.media }}" />
{% endfor %}
{% for script in scripts %}
<script src="{{ script }}" type="text/javascript"></script>
{% endfor %}
<script src="catalog/view/javascript/common.js" type="text/javascript"></script>
{% for link in links %}
<link href="{{ link.href }}" rel="{{ link.rel }}" />
{% endfor %}
{% for analytic in analytics %}
{{ analytic }}
{% endfor %}
</head>
<body class="{{ class }}">
<div id="search_background"></div>
<div id="menu_background"></div> 
<div id="wrapper">
<div id="main">
<header>
  <div class="container">

    <div class="header_inner">
      <div class="header_left_box">
        <div class="header__burger"><span></span></div>
        <img id="header_mobile_search_icon" src="image/icons/header-search.svg" alt="Search" title="Search">
      </div>
      <div id="logo">
            {% if logo %}
              {% if home == og_url %}
                <img src="{{ logo }}" title="{{ name }}" alt="{{ name }}" class="img-responsive" />
              {% else %}
                <a href="{{ home }}"><img src="{{ logo }}" title="{{ name }}" alt="{{ name }}" class="img-responsive" /></a>
              {% endif %}
            {% else %}
              <h1><a href="{{ home }}">{{ name }}</a></h1>
            {% endif %}
      </div>
      <div style="display: none;" class="top-menu__wishlist" data-products="{{ wishlist.products }}"></div>
      <div class="header_menu">
        

        <ul class="td-horizontal-menu mobile-navigation  list-unstyled header_list">
          {% for category in categories %}
            {% if category.children %}
              <li class="menu-item has-child {% if category.column <= '1' %} dropdown{% else %} mega{% endif %}">
                <a href="{{ category.href }}">{{ category.name }}</a>
                <span class="toggle-submenu hidden-lg-up"><i class="fa fa-angle-down"></i></span>
                <ul class="sub-menu column-{{ category.column }}">
                  {% for children in category.children|batch(category.children|length / category.column|round(1, 'ceil')) %}
                    {% for child in children %}
                      {% if child.children %}
                        <li class="menu-item has-child">
                          <a href="{{ child.href }}">{{ child.name }}</a>
                          <span class="toggle-submenu hidden-lg-up"><i class="fa fa-angle-down"></i></span>
                          <ul class="sub-menu">
                            {% for children in child.children %}
                              <li class="menu-item">
                                <a href="{{ children.href }}">{{ children.name }}</a>
                              </li>
                
                            {% endfor %}
                          </ul>
                        </li>
                      {% else %}
                        <li class="menu-item"><a href="{{ child.href }}">{{ child.name }}</a></li>
            
                      {% endif %}
                    {% endfor %}
                  {% endfor %}
                </ul>
              </li>
            {% else %}
              <li><a href="{{ category.href }}">{{ category.name }}</a></li>
        
            {% endif %}
          {% endfor %}
          <li><a href="{{ category_id_208 }}">{{ text_category_id_208 }} </a></li>
          <li><a class="color_red" href="{{ special }}">{{ text_special_1 }} </a></li> 
          {% if informations %}
              {% for information in informations %}
              <li><a href="{{ information.href }}">{{ information.title }}</a></li>
              {% endfor %}
          {% endif %}
          <li><a href="{{ contact }}">{{ text_contact }}</a></li>
        </ul>
      </div>
      <div class="header_right_box">
        <div id="header_search"><img src="image/icons/header-search.svg" alt="{{ text_search }}" title="{{ text_search }}"></div>
        <a id="header_account" href="{{ account }}"><img src="image/icons/header-user.svg" alt="{{ text_account }}" title="{{ text_account }}" height="20px"></a>
        <a href="{{ wishlist.href }}" id="wishlist-total" title="{{ text_wishlist }}"><img src="image/icons/header-wishlist.svg" alt="{{ text_wish }}" title="{{ text_wish }}" height="20px">
            {% if text_wishlist %}
            <span class="{# hidden-xs hidden-sm hidden-md #} ">{{ text_wishlist }}</span>
            {% else %}
            <span class="{# hidden-xs hidden-sm hidden-md #} no-items">{{ text_wishlist }}</span>
            {% endif %}
        </a>
        {{ cart }}{{ language }}
      </div>
    </div> 
    {{ search }} 
     <nav class="header__menu-mobile">
          <div class="header__menu-close"><img src="image/icons/mobile_close_icon.png"></div>
          <div id="mobile__menu-logo">
            {% if logo %}
              {% if home == og_url %}
                <img src="{{ logo }}" title="{{ name }}" alt="{{ name }}" class="img-responsive" />
              {% else %}
                <a href="{{ home }}"><img src="{{ logo }}" title="{{ name }}" alt="{{ name }}" class="img-responsive" /></a>
              {% endif %}
            {% else %}
              <h1><a href="{{ home }}">{{ name }}</a></h1>
            {% endif %}
          </div>
          {#<a href="{{ link_search }}"><div class="mobile__menu-search"><img src="image/catalog/header-search.png" alt="Search" title="Search">Search</div></a>
          <div class="mobile__menu-delimeter"></div>#}

          <div class="mobile__menu-list-title">{{ text_category }}</div>
          <ul class="category-top-menu block_content list-unstyled">
            <li class="category-item"><a href="{{ category_id_208 }}">{{ text_category_id_208 }}</a></li>  
            {% for category in categories %}
              {% if category.children %}
                <li class="category-item category-dropdown-menu">
                  <a href="javascript:void(0);{#{{ category.href }}#}" class="toggle-category">{{ category.name }}</a>
                  <span class="toggle-category"><i class="fa fa-angle-down"></i></span>
                  {% for children in category.children|batch(category.children|length) %}
                    <ul class="category-sub-menu">
                      {% for child in children %}
                        {% if child.children %}
                          <li class="category-item category-dropdown-menu">
                            <a href="{{ child.href }}">{{ child.name }}</a>
                            <span class="toggle-category"><i class="fa fa-angle-down"></i></span>
                            <ul class="category-sub-menu">
                              {% for children in child.children %}
                              <li class="category-item">
                                <a href="{{ children.href }}">{{ children.name }}</a>
                              </li>
                              {% endfor %}
                            </ul>
                          </li>
                        {% else %}
                        <li class="category-item"><a href="{{ child.href }}">{{ child.name }}</a></li>
                       {% endif %}
                     {% endfor %}
                    </ul>
                  {% endfor %}
                </li>
              {% else %}
                li><a href="{{ category.href }}">{{ category.name }}</a></li>
              {% endif %}
            {% endfor %}
            <li class="category-item"><a class="color_red" href="{{ special }}">{{ text_special_1 }}</a></li>  
          </ul>
          {# <div class="mobile__menu-delimeter"></div> #}
          {# <button class="btn-black" onclick="location.href='{{ link_custom }}'">Custom Order</button> #}
          <div class="mobile__menu-delimeter"></div>
          {# {% if informations_mobile %} #}
          <div class="mobile__menu-list-title">{{ text_information }}</div>
            <ul class="list-unstyled">
                {% for information in informations_mobile %}
                <li><a href="{{ information.href }}">{{ information.title }}</a></li>
                {% endfor %}
                <li><a href="{{ contact }}">{{ text_contact }}</a></li>
            </ul>
          {# {% endif %} #}
          <div class="mobile__menu-delimeter"></div>
          <div class="mobile__menu-account-block">
            <img src="image/icons/mobile-menu-user.png" alt="Account" title="Account" height="39px" width="39px">
            <div class="mobile__menu-login-block">
              <div><a href="{{ login }}">{{ text_login }}</a> | <a href="{{ register }}"><span>{{ text_register }}</span></a></div>
              <div class="login-block-text">{{ text_register_1 }}</div>
            </div>
            
          </div>
          <div class="mobile__menu-delimeter"></div>
          <div class="telephone_box">
