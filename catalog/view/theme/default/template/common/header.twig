              </svg>
            <a href="tel:{{ telephone }}">{{ telephone }}</a>
          </div> 
          <div class="mobile__menu-delimeter"></div>
          <div class="mobile__menu-list-title">{{ text_mobmenu_social }}</div>
          <div class="mobile__menu-follow">
            <a href="https://www.facebook.com/lilove.com.ua">
                {# <img src="image/catalog/mobile-menu-facebook.png" alt="Facebook" title="Facebook"> #}
