           <div class="mobile__menu-delimeter"></div>
           {{ language }}
        </nav>
        <div class="header__search-mobile">
          <div class="top_box">
            <img id="close_search_arrow" src="image/icons/arrow-left.png">
            <input type="text" name="mobile_search" id="mobile_search" placeholder="{{ text_search }} ...">
          </div> 
          <div class="header__search-mobile-title">{{ text_search_matches }}</div>
           <div class="product_matches"></div>
        </div>
  </div>
<script>
  const uniJsVars = {
      compare_btn:  {text: '{{ button_compare }}',  text_remove: '{{ button_compare_delete }}'},
