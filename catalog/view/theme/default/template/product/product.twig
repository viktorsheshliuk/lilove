      <div class="product__tabs-copy">
          <div id="accordion2" class="panel-group" role="tablist">
              <div class="panel panel-default">
                  <div class="panel-heading" role="tab" id="headingFour">
                      <a data-toggle="collapse" href="#tab-description-copy" data-parent="{# accordion2 #}" aria-expanded="false"> {{ tab_description }} </a>
                  </div>
                  <div id="tab-description-copy" class="panel-collapse collapse" role="tabpanel" aria-labelledby="headingFour">
                      <div class="tab-description">{{ description }}</div>
                      <ul class="product__details-list list-unstyled">
                        {% if sku %}
                        <li>{{ text_sku }} <span class="product__details-list-item">{{ sku }}</span> </li>
                        {% endif %}
                        {% if attribute_groups %}
                        {% for attribute_group in attribute_groups %}
                        {% for attribute in attribute_group.attribute %}    
                        <li>{{ attribute.name }}: <span class="product__details-list-item">{{ attribute.text }}</span></li>
                        {% endfor %}
                        {% endfor %}
                        {% endif %}
                        {% if weight %}
                        <li>{{ text_weight }} <span class="product__details-list-item">{{ weight }}</span></li>
                        {% endif %}
                      </ul>   
                  </div>
              </div>
              <div class="panel panel-default">
                  <div class="panel-heading" role="tab" id="headingFive">
                      <a data-toggle="collapse" href="#tab-shipping-copy" data-parent="{# accordion2 #}" aria-expanded="false" class="collapsed"> {{ tab_shipping }} </a>
                  </div>
                  <div id="tab-shipping-copy" class="panel-collapse collapse " role="tabpanel" aria-labelledby="headingFive" aria-expanded="false">
                      <div class="tab-shipping">{{ text_tab_shipping }}</div>
                  </div>
              </div>
              <div class="panel panel-default">
                  <div class="panel-heading" role="tab" id="headingSix">
                      <a data-toggle="collapse" href="#tab-review2" data-parent="" aria-expanded="false" class="collapsed"> {{ reviews }} </a>
                  </div>
                  <div id="tab-review2" class="panel-collapse collapse" role="tabpanel" aria-labelledby="headingSix" aria-expanded="false">
                      <div class="tab-review">
                        {% if review_status %}
                           <form id="form-review2">
                              <div id="review2"></div>
                              <div class="new__review-title">{{ text_write }}</div>
                              {% if review_guest %}
                              <div class="form-group required">
                                <label class="control-label" for="input-name">{{ entry_name }}</label>
                                <input type="text" name="name" value="{{ customer_name }}" id="input-name" class="form-control" placeholder="{{ entry_name }}" />
                              </div>
                              <div class="form-group required">
                                <label class="control-label" for="input-review">{{ entry_review }}</label>
                                <textarea name="text" rows="1" id="input-review" class="form-control" placeholder="{{ entry_review }}"></textarea>
                              </div>
                              <div class="form-group required rating-block">
                                  <label class="control-label">{{ entry_rating }}</label>
                                  <span>&nbsp;&nbsp;&nbsp; {{ entry_bad }}&nbsp;</span>
                                  <span>
                                    <input type="radio" name="rating" value="1" />
                                    &nbsp;
                                    <input type="radio" name="rating" value="2" />
                                    &nbsp;
                                    <input type="radio" name="rating" value="3" />
                                    &nbsp;
                                    <input type="radio" name="rating" value="4" />
                                    &nbsp;
                                    <input type="radio" name="rating" value="5" />
                                    </span>
                                  <span>&nbsp;{{ entry_good }}</span>
                              </div>
                              {{ captcha }}
                              <div class="buttons clearfix">
                                <div class="pull-left">
                                  <button type="button" id="button-review2" data-loading-text="{{ text_loading }}" class="btn btn-black">{{ button_send }}</button>
                                </div>
                              </div>
                              {% else %}
                              {{ text_login }}
                              {% endif %}
                          </form>
                       {% endif %}
                      </div>
                  </div>
              </div>
          </div>
