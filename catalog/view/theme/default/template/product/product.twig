  Fancybox.defaults.Hash = false;

  var galleryOptions = {
    Hash: false,
    Thumbs: {
      type: "classic",
    },
    Html: {
      videoAutoplay: true
    },
    on: {
      "done": function(fancybox, slide) {
        var video = slide && slide.el ? slide.el.querySelector('video') : null;

        if (video) {
          video.loop = true;
        }
      }
    }
  };

  var galleryItems = Array.prototype.slice.call(document.querySelectorAll('[data-fancybox="gallery"]'));

  galleryItems.sort(function(a, b) {
    var aMain = a.getAttribute('data-gallery-main') === '1' ? 1 : 0;
    var bMain = b.getAttribute('data-gallery-main') === '1' ? 1 : 0;

    if (aMain !== bMain) {
      return bMain - aMain;
    }

    var aOrder = parseInt(a.getAttribute('data-gallery-order'), 10) || 0;
    var bOrder = parseInt(b.getAttribute('data-gallery-order'), 10) || 0;

    if (aOrder !== bOrder) {
      return aOrder - bOrder;
    }

    var aPosition = parseInt(a.getAttribute('data-gallery-position'), 10) || 0;
    var bPosition = parseInt(b.getAttribute('data-gallery-position'), 10) || 0;

    return aPosition - bPosition;
  });

  galleryItems.forEach(function(item) {
    item.addEventListener('click', function(event) {
      event.preventDefault();

      Fancybox.fromNodes(galleryItems, Object.assign({}, galleryOptions, {
        startIndex: galleryItems.indexOf(item)
      }));
    });
  });

  var productVideos = document.querySelectorAll('.product__video-slide video[data-src]');

  function loadProductVideo(video) {
    if (video.getAttribute('data-loaded') === '1') {
      return;
    }

    video.setAttribute('data-loaded', '1');
    video.muted = true;
    video.loop = true;
    video.playsInline = true;
    video.src = video.getAttribute('data-src');
    video.load();
  }

  function playProductVideo(video) {
    var slide = video.closest('.product__video-slide');

    if (slide && slide.classList.contains('is-error')) {
      return;
    }

    loadProductVideo(video);

    var promise = video.play();

    if (promise && typeof promise.catch === 'function') {
      promise.catch(function() {});
    }
  }

  function pauseProductVideo(video) {
    if (!video.paused) {
      video.pause();
    }
  }

  Array.prototype.forEach.call(productVideos, function(video) {
    var slide = video.closest('.product__video-slide');
    var errorBox = slide ? slide.querySelector('.product__video-error') : null;

    video.addEventListener('playing', function() {
      if (slide) {
        slide.classList.add('is-playing');
      }
    });

    video.addEventListener('pause', function() {
      if (slide) {
        slide.classList.remove('is-playing');
      }
    });

    video.addEventListener('error', function() {
      if (slide) {
        slide.classList.add('is-error');
        slide.classList.remove('is-playing');
      }

      if (errorBox) {
        errorBox.hidden = false;
      }
    });
  });

  if ('IntersectionObserver' in window && productVideos.length) {
    var productVideoObserver = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        var video = entry.target.querySelector('video[data-src]');

        if (!video) {
          return;
        }

        if (entry.isIntersecting) {
          playProductVideo(video);
        } else {
          pauseProductVideo(video);
        }
      });
    }, {
      threshold: 0.5
    });

    Array.prototype.forEach.call(document.querySelectorAll('.product__video-slide'), function(slide) {
      productVideoObserver.observe(slide);
    });
  } else {
    Array.prototype.forEach.call(productVideos, function(video) {
      playProductVideo(video);
    });
  }

  document.addEventListener('visibilitychange', function() {
    if (document.hidden) {
      Array.prototype.forEach.call(productVideos, pauseProductVideo);
    } else {
      Array.prototype.forEach.call(productVideos, function(video) {
        var slide = video.closest('.product__video-slide');

        if (!slide) {
          return;
        }

        var rect = slide.getBoundingClientRect();

        if (rect.bottom > 0 && rect.top < window.innerHeight && rect.right > 0 && rect.left < window.innerWidth) {
          playProductVideo(video);
        }
      });
    }
  });

  //выбор первой опции при загрузке страницы 
  $('div[id^=input-option]').each(function(){  // для цвета
    $(this).find('.image-radio').first().find('input').prop('checked', true);
